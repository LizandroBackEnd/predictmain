{
  "dataset": {
    "path": "03_dataset/data/processed/ai4i2020_outlier_analyzed.csv",
    "target": "Machine failure",
    "features": [
      "Air temperature [K]",
      "Process temperature [K]",
      "Rotational speed [rpm]",
      "Torque [Nm]",
      "Tool wear [min]",
      "Temp_diff",
      "Type_L",
      "Type_M"
    ],
    "rows": 10000,
    "positive_class": 339,
    "negative_class": 9661
  },
  "split": {
    "train": 0.75,
    "test": 0.25,
    "stratify_by": ["Machine failure"],
    "random_state": 42,
    "note": "HU-08 usa 75/25 estratificado; la propuesta histórica 70/15/15 no se ejecutó."
  },
  "preprocessing": {
    "pipeline_artifact": "03_dataset/ml_service/artifacts/pipeline.joblib",
    "refit_on_train": true,
    "scaler": "StandardScaler",
    "encoder": "OneHotEncoder(drop='first')",
    "derived_features": ["Temp_diff"],
    "excluded_features": ["UDI", "Product ID", "TWF", "HDF", "PWF", "OSF", "RNF"],
    "note": "La definición es HU-06; HU-08 reajusta el pipeline solo con el 75% de entrenamiento para evitar fuga."
  },
  "models": [
    {
      "name": "logistic_regression",
      "class_weight": "balanced",
      "max_iter": 1000,
      "role": "línea base interpretable"
    },
    {
      "name": "random_forest",
      "class_weight": "balanced",
      "n_estimators": 300,
      "random_state": 42,
      "role": "comparación principal para datos tabulares"
    }
  ],
  "cross_validation": {
    "strategy": "StratifiedKFold",
    "folds": 5,
    "shuffle": true,
    "random_state": 42,
    "status": "diferido_a_iteracion_posterior"
  },
  "threshold": {
    "initial": 0.5,
    "optimize_on": "ninguno_en_linea_base",
    "priority_metric": "recall",
    "note": "Sin conjunto de validación en HU-08; la optimización del umbral se difiere."
  },
  "metrics": [
    "accuracy",
    "precision",
    "recall",
    "f1",
    "roc_auc",
    "pr_auc",
    "confusion_matrix"
  ],
  "selection": {
    "primary": "f1",
    "tie_breaker": "recall"
  },
  "artifacts": {
    "model_output_dir": "ml_service/artifacts",
    "model_output_file": "ml_service/artifacts/modelo.joblib",
    "metrics_report": "reports/model_baseline.md"
  },
  "llm_adaptation": {
    "strategy": "rag_prompt_engineering",
    "fine_tuning": false,
    "corpus_path": "02_corpus/salidas/corpus_procesado.txt",
    "source_pdf_sha256": "78190C534B822D0245A4E98FF51FC6A77AF4D52B7C1C295F105B9B0575B04EFE",
    "corpus_processed_sha256": "33C0B54C48759B9E051BBD9159733C7563C27C865426A2B9D6125EB20C711683",
    "chunk_size": 800,
    "chunk_overlap": 120,
    "retrieval_top_k": 5,
    "similarity": "cosine",
    "temperature": 0.2,
    "max_tokens": 1000,
    "language": "es",
    "citation": "documento, seccion, pagina",
    "abstention": "No tengo evidencia suficiente",
    "status": "designed_pending_implementation"
  },
  "status": "pending_execution"
}
