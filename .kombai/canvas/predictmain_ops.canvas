    "var_telemetria_claro": {
      "type": "variant",
      "label": "telemetria_claro",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 13140,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n:root{\n  --bg:#F4F4F1; --panel:#FFFFFF; --raised:#FAFAF6; --sel:#E9E9E2;\n  --line:#DCDCD4; --line-strong:#BFBFB4;\n  --fg:#141414; --fg-2:#53585B; --fg-3:#6E7377;\n  --btn-bg:#141414; --btn-fg:#FFFFFF;\n  --crit:#A32A22; --crit-fill:rgba(163,42,34,.07);\n  --warn:#7A4E00; --warn-fill:rgba(122,78,0,.07);\n  --ok:#2C5F40;\n  --risk:#185C7D; --air:#185C7D; --proc:#8A5200; --rpm:#175B5B; --torque:#8B3F2C; --wear:#5A5A5A;\n  --grid:#E8E8E0; --band-fill:rgba(24,92,125,.055); --risk-fill:rgba(24,92,125,.16);\n}\n*{box-sizing:border-box;margin:0;padding:0;}\nbody{background:var(--bg);color:var(--fg);font-family:'Geist',system-ui,sans-serif;font-size:13px;-webkit-font-smoothing:antialiased;}\n.mono{font-family:'Geist Mono',monospace;font-feature-settings:\"tnum\" 1,\"zero\" 1;letter-spacing:-.01em;}\n.faint{color:var(--fg-3);} .muted{color:var(--fg-2);}\n.shell{display:flex;height:900px;overflow:hidden;}\n.side{width:176px;flex:0 0 176px;border-right:1px solid var(--line);display:flex;flex-direction:column;}\n.brand{height:56px;display:flex;align-items:center;gap:9px;padding:0 16px;border-bottom:1px solid var(--line);}\n.mark{width:22px;height:22px;border-radius:3px;background:var(--fg);color:var(--bg);display:grid;place-items:center;font-family:'Geist Mono',monospace;font-size:10px;font-weight:600;}\n.brand b{font-size:13px;font-weight:600;letter-spacing:-.015em;}\n.brand span{display:block;font-size:9.5px;letter-spacing:.09em;text-transform:uppercase;color:var(--fg-3);margin-top:2px;}\n.nav{padding:12px 8px;display:flex;flex-direction:column;gap:2px;}\n.nav a{display:flex;align-items:center;gap:10px;height:34px;padding:0 9px;border-radius:4px;color:var(--fg-2);text-decoration:none;font-size:13px;}\n.nav a i{font-size:15px;color:var(--fg-3);}\n.nav a.on{background:var(--sel);color:var(--fg);font-weight:500;}\n.nav a.on i{color:var(--fg);}\n.nav-label{font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--fg-3);padding:14px 9px 6px;}\n.sidefoot{margin-top:auto;padding:14px 16px 16px;border-top:1px solid var(--line);font-size:10.5px;color:var(--fg-3);line-height:1.5;}\n.main{flex:1;display:flex;flex-direction:column;min-width:0;}\n.top{height:56px;flex:0 0 56px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 20px;}\n.scope{display:flex;align-items:center;gap:10px;}\n.plant{display:flex;align-items:center;gap:8px;height:30px;padding:0 9px;border:1px solid var(--line);border-radius:4px;color:var(--fg);background:var(--panel);font:inherit;font-size:12.5px;font-weight:500;}\n.plant i{font-size:13px;color:var(--fg-2);}\n.vr{width:1px;height:16px;background:var(--line);}\n.topright{display:flex;align-items:center;gap:14px;}\n.stamp{font-size:11px;color:var(--fg-3);}\n.btn{display:inline-flex;align-items:center;gap:7px;height:32px;padding:0 11px;border-radius:4px;border:1px solid var(--line-strong);background:transparent;color:var(--fg);font:inherit;font-size:12.5px;cursor:pointer;white-space:nowrap;}\n.btn i{font-size:14px;color:var(--fg-2);}\n.btn.solid{background:var(--btn-bg);color:var(--btn-fg);border-color:var(--btn-bg);font-weight:500;}\n.ctl{display:flex;align-items:center;gap:7px;height:32px;padding:0 10px;border:1px solid var(--line);border-radius:4px;background:var(--panel);font-size:12px;color:var(--fg-2);white-space:nowrap;}\n.ctl b{color:var(--fg);font-weight:500;}\n.ctl i{font-size:12px;color:var(--fg-3);}\n.content{padding:20px;display:flex;flex-direction:column;gap:14px;flex:1;min-height:0;overflow:hidden;}\n.vhead{display:flex;align-items:flex-end;justify-content:space-between;flex:0 0 auto;}\n.vhead h1{font-size:22px;font-weight:600;letter-spacing:-.022em;}\n.vhead h1 em{font-style:normal;color:var(--fg-3);font-weight:400;font-size:13px;letter-spacing:0;margin-left:10px;}\n.toolbar{display:flex;align-items:center;justify-content:space-between;flex:0 0 auto;}\n.tleft,.tright{display:flex;align-items:center;gap:8px;}\n.seg{display:flex;border:1px solid var(--line);border-radius:3px;overflow:hidden;height:32px;align-items:center;}\n.seg span{padding:0 10px;font-size:11.5px;color:var(--fg-3);font-family:'Geist Mono',monospace;display:flex;align-items:center;height:100%;}\n.seg span.on{background:var(--sel);color:var(--fg);}\n.sw{display:flex;align-items:center;gap:8px;font-size:11.5px;color:var(--fg-2);height:32px;padding:0 2px;}\n.panel{border:1px solid var(--line);border-radius:6px;background:var(--panel);padding:16px 20px 14px;display:flex;flex-direction:column;flex:1;min-height:0;}\n.track{display:flex;align-items:flex-start;}\n.tlab{width:118px;flex:0 0 118px;padding-top:2px;}\n.tname{font-size:9.5px;letter-spacing:.07em;text-transform:uppercase;color:var(--fg-3);}\n.srow{display:flex;align-items:center;gap:6px;font-size:11px;color:var(--fg-2);margin-top:6px;}\n.srow .sw2{width:14px;height:0;border-top:2px solid var(--c);flex:0 0 14px;}\n.srow .sw2.dash{border-top-style:dashed;} .srow .sw2.dotd{border-top-style:dotted;}\n.tlim{font-size:9.5px;font-family:'Geist Mono',monospace;margin-top:6px;}\n.tyaxis{width:38px;flex:0 0 38px;position:relative;height:96px;}\n.tyaxis span{position:absolute;right:7px;transform:translateY(-50%);font-family:'Geist Mono',monospace;font-size:8.5px;color:var(--fg-3);letter-spacing:-.02em;}\n.tyaxis s{position:absolute;right:0;width:4px;border-top:1px solid var(--line-strong);text-decoration:none;}\n.tplot{flex:1;min-width:0;}\n.tplot svg{display:block;width:100%;}\n.xaxis{display:flex;justify-content:space-between;margin-left:156px;font-family:'Geist Mono',monospace;font-size:9px;color:var(--fg-3);padding-top:2px;}\n.cursorbar{display:flex;align-items:center;margin-top:auto;border-top:1px solid var(--line);padding-top:12px;}\n.curlab{width:156px;flex:0 0 156px;font-size:9.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--fg-3);}\n.curlab b{display:block;font-family:'Geist Mono',monospace;font-size:12px;color:var(--fg);letter-spacing:0;margin-top:3px;text-transform:none;}\n.cv{display:grid;grid-template-columns:repeat(7,1fr);flex:1;}\n.cvc .k{font-size:9.5px;letter-spacing:.05em;text-transform:uppercase;color:var(--fg-3);}\n.cvc .v{font-family:'Geist Mono',monospace;font-size:14px;margin-top:4px;letter-spacing:-.02em;}\n.cvc .v u{text-decoration:none;font-size:9.5px;color:var(--fg-3);margin-left:2px;}\n.sample{flex:0 0 auto;}\n.sh{display:flex;align-items:center;justify-content:space-between;height:32px;}\n.sh h3{font-size:12.5px;font-weight:600;letter-spacing:-.01em;}\n.sgrid{display:grid;grid-template-columns:140px 118px 128px 96px 138px 118px 138px 1fr;align-items:center;padding:0 10px;height:32px;font-size:9.5px;letter-spacing:.07em;text-transform:uppercase;color:var(--fg-3);border-bottom:1px solid var(--line-strong);}\n.srow2{display:grid;grid-template-columns:140px 118px 128px 96px 138px 118px 138px 1fr;align-items:center;padding:0 10px;height:44px;border-bottom:1px solid var(--line);font-family:'Geist Mono',monospace;font-size:12px;}\n.srow2 .t{color:var(--fg-2);} .srow2 .type{font-size:10px;color:var(--fg-3);}\n</style>\n<div class=\"shell\" data-kid=\"1\">\n<aside class=\"side\" data-kid=\"1-1\">\n<div class=\"brand\" data-kid=\"1-1-1\"><div class=\"mark\" data-kid=\"1-1-1-1\">PM</div><div data-kid=\"1-1-1-2\"><b data-kid=\"1-1-1-2-1\">PredictMain</b><span data-kid=\"1-1-1-2-2\">Mantenimiento</span></div></div>\n<nav class=\"nav\" data-kid=\"1-1-2\">\n<div class=\"nav-label\" data-kid=\"1-1-2-1\">Operación</div>\n<a data-kid=\"1-1-2-2\" href=\"#\"><i class=\"icon-list-ordered\" data-kid=\"1-1-2-2-1\"></i>Operación</a>\n<a data-kid=\"1-1-2-3\" href=\"#\"><i class=\"icon-factory\" data-kid=\"1-1-2-3-1\"></i>Activos</a>\n<a class=\"on\" data-kid=\"1-1-2-4\" href=\"#\"><i class=\"icon-chart-no-axes-combined\" data-kid=\"1-1-2-4-1\"></i>Telemetría</a>\n<a data-kid=\"1-1-2-5\" href=\"#\"><i class=\"icon-triangle-alert\" data-kid=\"1-1-2-5-1\"></i>Riesgo de falla</a>\n<a data-kid=\"1-1-2-6\" href=\"#\"><i class=\"icon-book-open\" data-kid=\"1-1-2-6-1\"></i>Base de conocimiento</a>\n</nav>\n<div class=\"sidefoot\" data-kid=\"1-1-3\">Modelo activo<br data-kid=\"1-1-3-1\"/><span class=\"mono\" data-kid=\"1-1-3-2\" style=\"color:var(--fg-2)\">random_forest</span></div>\n</aside>\n<div class=\"main\" data-kid=\"1-2\">\n<header class=\"top\" data-kid=\"1-2-1\">\n<div class=\"scope\" data-kid=\"1-2-1-1\">\n<button class=\"plant\" data-kid=\"1-2-1-1-1\"><i class=\"icon-factory\" data-kid=\"1-2-1-1-1-1\"></i>Planta Norte<i class=\"icon-chevron-down\" data-kid=\"1-2-1-1-1-2\"></i></button>\n<div class=\"vr\" data-kid=\"1-2-1-1-2\"></div>\n<span class=\"faint\" data-kid=\"1-2-1-1-3\" style=\"font-size:11.5px\">Fresado y torneado</span>\n</div>\n<div class=\"topright\" data-kid=\"1-2-1-2\">\n<span class=\"stamp mono\" data-kid=\"1-2-1-2-1\">Lecturas hasta 23 nov 13:04</span>\n<button class=\"btn\" data-kid=\"1-2-1-2-2\"><i class=\"icon-book-open\" data-kid=\"1-2-1-2-2-1\"></i>Asistente técnico</button>\n</div>\n</header>\n<div class=\"content\" data-kid=\"1-2-2\">\n<div class=\"vhead\" data-kid=\"1-2-2-1\">\n<h1 data-kid=\"1-2-2-1-1\">Telemetría<em data-kid=\"1-2-2-1-1-1\">Fresadora Cincinnati 4 · FR-204</em></h1>\n<div class=\"tright\" data-kid=\"1-2-2-1-2\"><button class=\"ctl\" data-kid=\"1-2-2-1-2-1\"><b data-kid=\"1-2-2-1-2-1-1\">Fresadora Cincinnati 4</b><i class=\"icon-chevron-down\" data-kid=\"1-2-2-1-2-1-2\"></i></button></div>\n</div>\n<div class=\"toolbar\" data-kid=\"1-2-2-2\">\n<div class=\"tleft\" data-kid=\"1-2-2-2-1\">\n<div class=\"ctl\" data-kid=\"1-2-2-2-1-1\"><span data-kid=\"1-2-2-2-1-1-1\">Rango</span><b class=\"mono\" data-kid=\"1-2-2-2-1-1-2\">22 nov 13:00 — 23 nov 13:00</b><i class=\"icon-calendar\" data-kid=\"1-2-2-2-1-1-3\"></i></div>\n<div class=\"seg\" data-kid=\"1-2-2-2-1-2\"><span data-kid=\"1-2-2-2-1-2-1\">1 h</span><span class=\"on\" data-kid=\"1-2-2-2-1-2-2\">24 h</span><span data-kid=\"1-2-2-2-1-2-3\">7 d</span></div>\n<button class=\"ctl\" data-kid=\"1-2-2-2-1-3\"><i class=\"icon-sliders-horizontal\" data-kid=\"1-2-2-2-1-3-1\"></i>Sensores <b data-kid=\"1-2-2-2-1-3-2\">5</b></button>\n</div>\n<div class=\"tright\" data-kid=\"1-2-2-2-2\">\n<div class=\"sw\" data-kid=\"1-2-2-2-2-1\">Umbrales de ingeniería\n            <span data-kid=\"1-2-2-2-2-1-1\" style=\"width:26px;height:14px;border-radius:7px;background:var(--fg);display:inline-flex;align-items:center;padding:2px;justify-content:flex-end\"><span data-kid=\"1-2-2-2-2-1-1-1\" style=\"width:10px;height:10px;border-radius:50%;background:var(--bg)\"></span></span>\n</div>\n<div class=\"vr\" data-kid=\"1-2-2-2-2-2\"></div>\n<span class=\"faint mono\" data-kid=\"1-2-2-2-2-3\" style=\"font-size:11px\">96 lecturas</span>\n</div>\n</div>\n<section class=\"panel\" data-kid=\"1-2-2-3\">\n<div class=\"track\" data-kid=\"1-2-2-3-1\">\n<div class=\"tlab\" data-kid=\"1-2-2-3-1-1\">\n<div class=\"tname\" data-kid=\"1-2-2-3-1-1-1\">Temperatura [K]</div>\n<div class=\"srow\" data-kid=\"1-2-2-3-1-1-2\" style=\"--c:var(--air)\"><span class=\"sw2\" data-kid=\"1-2-2-3-1-1-2-1\"></span><span data-kid=\"1-2-2-3-1-1-2-2\">Aire</span></div>\n<div class=\"srow\" data-kid=\"1-2-2-3-1-1-3\" style=\"--c:var(--proc)\"><span class=\"sw2 dash\" data-kid=\"1-2-2-3-1-1-3-1\"></span><span data-kid=\"1-2-2-3-1-1-3-2\">Proceso</span></div>\n<div class=\"tlim\" data-kid=\"1-2-2-3-1-1-4\" style=\"color:var(--fg-3)\">ΔT 10.3 K</div>\n</div>\n<div class=\"tyaxis\" data-kid=\"1-2-2-3-1-2\"><span data-kid=\"1-2-2-3-1-2-1\" style=\"top:8px\">316</span><span data-kid=\"1-2-2-3-1-2-2\" style=\"top:48px\">306</span><span data-kid=\"1-2-2-3-1-2-3\" style=\"top:88px\">296</span></div>\n<div class=\"tplot\" data-kid=\"1-2-2-3-1-3\">\n<svg data-kid=\"1-2-2-3-1-3-1\" height=\"96\" viewbox=\"0 0 1024 96\">\n<line stroke=\"var(--grid)\" x1=\"0\" x2=\"1010\" y1=\"8\" y2=\"8\"></line>\n<line stroke=\"var(--grid)\" x1=\"0\" x2=\"1010\" y1=\"48\" y2=\"48\"></line>\n<line stroke=\"var(--line-strong)\" x1=\"0\" x2=\"1010\" y1=\"88\" y2=\"88\"></line>\n<line opacity=\".5\" stroke=\"var(--fg-3)\" stroke-width=\"1\" x1=\"851\" x2=\"851\" y1=\"0\" y2=\"96\"></line>\n<path d=\"M0 76 L11 75 L21 75 L32 75 L43 76 L53 74 L64 74 L74 75 L85 75 L96 75 L106 76 L117 75 L128 74 L138 75 L149 73 L159 74 L170 74 L181 75 L191 72 L202 73 L213 72 L223 73 L234 74 L245 73 L255 73 L266 74 L276 71 L287 73 L298 73 L308 71 L319 72 L330 71 L340 72 L351 72 L361 72 L372 72 L383 72 L393 73 L404 71 L415 72 L425 71 L436 72 L447 70 L457 70 L468 71 L478 71 L489 71 L500 71 L510 72 L521 71 L532 70 L542 72 L553 70 L563 70 L574 71 L585 71 L595 71 L606 71 L617 69 L627 71 L638 70 L649 71 L659 69 L670 69 L680 70 L691 70 L702 69 L712 69 L723 70 L734 69 L744 68 L755 68 L765 69 L776 69 L787 68 L797 67 L808 68 L819 67 L829 68 L840 68 L851 67 L861 66 L872 66 L882 66 L893 65 L904 65 L914 64 L925 64 L936 65 L946 63 L957 63 L967 63 L978 62 L989 63 L999 63 L1010 62\" fill=\"none\" stroke=\"var(--air)\" stroke-width=\"1.6\"></path>\n<path d=\"M0 34 L11 34 L21 34 L32 33 L43 34 L53 34 L64 34 L74 33 L85 34 L96 33 L106 33 L117 33 L128 33 L138 33 L149 33 L159 32 L170 33 L181 33 L191 32 L202 32 L213 33 L223 32 L234 32 L245 31 L255 32 L266 32 L276 32 L287 32 L298 31 L308 31 L319 32 L330 32 L340 31 L351 31 L361 32 L372 31 L383 31 L393 31 L404 32 L415 31 L425 31 L436 32 L447 31 L457 31 L468 32 L478 31 L489 31 L500 31 L510 30 L521 30 L532 30 L542 30 L553 30 L563 30 L574 31 L585 31 L595 30 L606 30 L617 30 L627 31 L638 30 L649 29 L659 29 L670 29 L680 30 L691 29 L702 28 L712 28 L723 27 L734 29 L744 28 L755 27 L765 27 L776 27 L787 27 L797 27 L808 27 L819 25 L829 27 L840 26 L851 26 L861 25 L872 24 L882 25 L893 24 L904 24 L914 24 L925 24 L936 23 L946 23 L957 23 L967 23 L978 22 L989 21 L999 21 L1010 21\" fill=\"none\" stroke=\"var(--proc)\" stroke-dasharray=\"5 3\" stroke-width=\"1.6\"></path>\n<circle cx=\"851\" cy=\"66.8\" fill=\"var(--air)\" r=\"3\" stroke=\"var(--panel)\" stroke-width=\"1.5\"></circle>\n<circle cx=\"851\" cy=\"25.6\" fill=\"var(--proc)\" r=\"3\" stroke=\"var(--panel)\" stroke-width=\"1.5\"></circle>\n</svg>\n</div>\n</div>\n<div class=\"track\" data-kid=\"1-2-2-3-2\" style=\"margin-top:16px\">\n<div class=\"tlab\" data-kid=\"1-2-2-3-2-1\">\n<div class=\"tname\" data-kid=\"1-2-2-3-2-1-1\">Velocidad [rpm]</div>\n<div class=\"srow\" data-kid=\"1-2-2-3-2-1-2\" style=\"--c:var(--rpm)\"><span class=\"sw2 dotd\" data-kid=\"1-2-2-3-2-1-2-1\"></span><span data-kid=\"1-2-2-3-2-1-2-2\">Rotación</span></div>\n<div class=\"tlim\" data-kid=\"1-2-2-3-2-1-3\" style=\"color:var(--warn)\">límite 1,380</div>\n</div>\n<div class=\"tyaxis\" data-kid=\"1-2-2-3-2-2\"><span data-kid=\"1-2-2-3-2-2-1\" style=\"top:8px\">1700</span><span data-kid=\"1-2-2-3-2-2-2\" style=\"top:48px\">1400</span><span data-kid=\"1-2-2-3-2-2-3\" style=\"top:88px\">1100</span></div>\n<div class=\"tplot\" data-kid=\"1-2-2-3-2-3\">\n<svg data-kid=\"1-2-2-3-2-3-1\" height=\"96\" viewbox=\"0 0 1024 96\">\n<line stroke=\"var(--grid)\" x1=\"0\" x2=\"1010\" y1=\"8\" y2=\"8\"></line>\n<line stroke=\"var(--grid)\" x1=\"0\" x2=\"1010\" y1=\"48\" y2=\"48\"></line>\n<line stroke=\"var(--line-strong)\" x1=\"0\" x2=\"1010\" y1=\"88\" y2=\"88\"></line>\n<line opacity=\".5\" stroke=\"var(--fg-3)\" stroke-width=\"1\" x1=\"851\" x2=\"851\" y1=\"0\" y2=\"96\"></line>\n<line opacity=\".6\" stroke=\"var(--warn)\" stroke-dasharray=\"4 4\" stroke-width=\"1\" x1=\"0\" x2=\"1010\" y1=\"50.7\" y2=\"50.7\"></line>\n<path d=\"M0 28 L11 30 L21 30 L32 27 L43 29 L53 28 L64 29 L74 30 L85 28 L96 29 L106 29 L117 29 L128 29 L138 31 L149 33 L159 33 L170 30 L181 33 L191 31 L202 31 L213 32 L223 30 L234 34 L245 29 L255 29 L266 33 L276 30 L287 30 L298 33 L308 30 L319 33 L330 28 L340 29 L351 28 L361 32 L372 31 L383 29 L393 29 L404 31 L415 27 L425 29 L436 31 L447 32 L457 29 L468 31 L478 30 L489 31 L500 31 L510 34 L521 33 L532 32 L542 30 L553 32 L563 31 L574 32 L585 31 L595 32 L606 34 L617 35 L627 36 L638 34 L649 32 L659 32 L670 33 L680 36 L691 33 L702 36 L712 32 L723 34 L734 33 L744 34 L755 35 L765 33 L776 33 L787 37 L797 36 L808 34 L819 35 L829 36 L840 36 L851 36 L861 37 L872 37 L882 35 L893 37 L904 33 L914 35 L925 34 L936 38 L946 37 L957 40 L967 40 L978 43 L989 45 L999 47 L1010 45\" fill=\"none\" stroke=\"var(--rpm)\" stroke-dasharray=\"6 2 1 2\" stroke-width=\"1.6\"></path>\n<circle cx=\"851\" cy=\"36.1\" fill=\"var(--rpm)\" r=\"3\" stroke=\"var(--panel)\" stroke-width=\"1.5\"></circle>\n</svg>\n</div>\n</div>\n<div class=\"track\" data-kid=\"1-2-2-3-3\" style=\"margin-top:16px\">\n<div class=\"tlab\" data-kid=\"1-2-2-3-3-1\">\n<div class=\"tname\" data-kid=\"1-2-2-3-3-1-1\">Torque [Nm]</div>\n<div class=\"srow\" data-kid=\"1-2-2-3-3-1-2\" style=\"--c:var(--torque)\"><span class=\"sw2\" data-kid=\"1-2-2-3-3-1-2-1\"></span><span data-kid=\"1-2-2-3-3-1-2-2\">Par aplicado</span></div>\n<div class=\"tlim\" data-kid=\"1-2-2-3-3-1-3\" style=\"color:var(--warn)\">límite 61.0</div>\n</div>\n<div class=\"tyaxis\" data-kid=\"1-2-2-3-3-2\"><span data-kid=\"1-2-2-3-3-2-1\" style=\"top:8px\">70</span><span data-kid=\"1-2-2-3-3-2-2\" style=\"top:48px\">50</span><span data-kid=\"1-2-2-3-3-2-3\" style=\"top:88px\">30</span></div>\n<div class=\"tplot\" data-kid=\"1-2-2-3-3-3\">\n<svg data-kid=\"1-2-2-3-3-3-1\" height=\"96\" viewbox=\"0 0 1024 96\">\n<line stroke=\"var(--grid)\" x1=\"0\" x2=\"1010\" y1=\"8\" y2=\"8\"></line>\n<line stroke=\"var(--grid)\" x1=\"0\" x2=\"1010\" y1=\"48\" y2=\"48\"></line>\n<line stroke=\"var(--line-strong)\" x1=\"0\" x2=\"1010\" y1=\"88\" y2=\"88\"></line>\n<line opacity=\".5\" stroke=\"var(--fg-3)\" stroke-width=\"1\" x1=\"851\" x2=\"851\" y1=\"0\" y2=\"96\"></line>\n<line opacity=\".6\" stroke=\"var(--warn)\" stroke-dasharray=\"4 4\" stroke-width=\"1\" x1=\"0\" x2=\"1010\" y1=\"26\" y2=\"26\"></line>\n<path d=\"M0 71 L11 71 L21 72 L32 69 L43 71 L53 70 L64 69 L74 70 L85 68 L96 69 L106 70 L117 69 L128 69 L138 70 L149 68 L159 70 L170 67 L181 68 L191 70 L202 70 L213 69 L223 67 L234 70 L245 68 L255 69 L266 67 L276 67 L287 67 L298 69 L308 67 L319 68 L330 66 L340 68 L351 66 L361 66 L372 66 L383 66 L393 66 L404 67 L415 68 L425 65 L436 67 L447 69 L457 67 L468 67 L478 68 L489 65 L500 68 L510 65 L521 66 L532 68 L542 67 L553 67 L563 68 L574 65 L585 66 L595 65 L606 65 L617 65 L627 64 L638 66 L649 65 L659 65 L670 64 L680 63 L691 62 L702 62 L712 61 L723 64 L734 62 L744 62 L755 60 L765 60 L776 59 L787 58 L797 58 L808 56 L819 55 L829 55 L840 51 L851 52 L861 50 L872 48 L882 46 L893 43 L904 43 L914 40 L925 40 L936 38 L946 37 L957 34 L967 32 L978 29 L989 29 L999 25 L1010 23\" fill=\"none\" stroke=\"var(--torque)\" stroke-width=\"1.6\"></path>\n<circle cx=\"851\" cy=\"52.4\" fill=\"var(--torque)\" r=\"3\" stroke=\"var(--panel)\" stroke-width=\"1.5\"></circle>\n</svg>\n</div>\n</div>\n<div class=\"track\" data-kid=\"1-2-2-3-4\" style=\"margin-top:16px\">\n<div class=\"tlab\" data-kid=\"1-2-2-3-4-1\">\n<div class=\"tname\" data-kid=\"1-2-2-3-4-1-1\">Desgaste [min]</div>\n<div class=\"srow\" data-kid=\"1-2-2-3-4-1-2\" style=\"--c:var(--wear)\"><span class=\"sw2\" data-kid=\"1-2-2-3-4-1-2-1\"></span><span data-kid=\"1-2-2-3-4-1-2-2\">Acumulado</span></div>\n<div class=\"tlim\" data-kid=\"1-2-2-3-4-1-3\" style=\"color:var(--crit)\">límite 240</div>\n</div>\n<div class=\"tyaxis\" data-kid=\"1-2-2-3-4-2\"><span data-kid=\"1-2-2-3-4-2-1\" style=\"top:8px\">250</span><span data-kid=\"1-2-2-3-4-2-2\" style=\"top:48px\">175</span><span data-kid=\"1-2-2-3-4-2-3\" style=\"top:88px\">100</span></div>\n<div class=\"tplot\" data-kid=\"1-2-2-3-4-3\">\n<svg data-kid=\"1-2-2-3-4-3-1\" height=\"96\" viewbox=\"0 0 1024 96\">\n<line stroke=\"var(--grid)\" x1=\"0\" x2=\"1010\" y1=\"8\" y2=\"8\"></line>\n<line stroke=\"var(--grid)\" x1=\"0\" x2=\"1010\" y1=\"48\" y2=\"48\"></line>\n<line stroke=\"var(--line-strong)\" x1=\"0\" x2=\"1010\" y1=\"88\" y2=\"88\"></line>\n<line opacity=\".5\" stroke=\"var(--fg-3)\" stroke-width=\"1\" x1=\"851\" x2=\"851\" y1=\"0\" y2=\"96\"></line>\n<line opacity=\".6\" stroke=\"var(--crit)\" stroke-dasharray=\"4 4\" stroke-width=\"1\" x1=\"0\" x2=\"1010\" y1=\"13.3\" y2=\"13.3\"></line>\n<path d=\"M0 84 L11 83 L21 82 L32 81 L43 81 L53 80 L64 79 L74 79 L85 78 L96 77 L106 77 L117 76 L128 75 L138 75 L149 74 L159 73 L170 72 L181 72 L191 71 L202 70 L213 70 L223 69 L234 68 L245 68 L255 67 L266 66 L276 65 L287 64 L298 64 L308 63 L319 62 L330 62 L340 61 L351 61 L361 60 L372 60 L383 59 L393 58 L404 57 L415 56 L425 56 L436 55 L447 55 L457 54 L468 53 L478 53 L489 52 L500 51 L510 51 L521 50 L532 50 L542 49 L553 48 L563 48 L574 47 L585 46 L595 45 L606 45 L617 44 L627 43 L638 43 L649 42 L659 41 L670 40 L680 40 L691 39 L702 38 L712 37 L723 36 L734 36 L744 35 L755 34 L765 33 L776 33 L787 32 L797 32 L808 31 L819 30 L829 29 L840 29 L851 28 L861 27 L872 27 L882 26 L893 26 L904 25 L914 24 L925 23 L936 23 L946 22 L957 21 L967 21 L978 20 L989 20 L999 19 L1010 18\" fill=\"none\" stroke=\"var(--wear)\" stroke-width=\"1.6\"></path>\n<circle cx=\"851\" cy=\"28\" fill=\"var(--wear)\" r=\"3\" stroke=\"var(--panel)\" stroke-width=\"1.5\"></circle>\n</svg>\n</div>\n</div>\n<div class=\"xaxis\" data-kid=\"1-2-2-3-5\">\n<span data-kid=\"1-2-2-3-5-1\">13:00</span><span data-kid=\"1-2-2-3-5-2\">17:00</span><span data-kid=\"1-2-2-3-5-3\">21:00</span><span data-kid=\"1-2-2-3-5-4\">01:00</span><span data-kid=\"1-2-2-3-5-5\">05:00</span><span data-kid=\"1-2-2-3-5-6\">09:00</span><span data-kid=\"1-2-2-3-5-7\">13:00</span>\n</div>\n<div class=\"cursorbar\" data-kid=\"1-2-2-3-6\">\n<div class=\"curlab\" data-kid=\"1-2-2-3-6-1\">Muestra en cursor<b data-kid=\"1-2-2-3-6-1-1\">23 nov 09:00</b></div>\n<div class=\"cv\" data-kid=\"1-2-2-3-6-2\">\n<div class=\"cvc\" data-kid=\"1-2-2-3-6-2-1\"><div class=\"k\" data-kid=\"1-2-2-3-6-2-1-1\">Aire</div><div class=\"v\" data-kid=\"1-2-2-3-6-2-1-2\">301.3<u data-kid=\"1-2-2-3-6-2-1-2-1\">K</u></div></div>\n<div class=\"cvc\" data-kid=\"1-2-2-3-6-2-2\"><div class=\"k\" data-kid=\"1-2-2-3-6-2-2-1\">Proceso</div><div class=\"v\" data-kid=\"1-2-2-3-6-2-2-2\">311.6<u data-kid=\"1-2-2-3-6-2-2-2-1\">K</u></div></div>\n<div class=\"cvc\" data-kid=\"1-2-2-3-6-2-3\"><div class=\"k\" data-kid=\"1-2-2-3-6-2-3-1\">ΔT</div><div class=\"v\" data-kid=\"1-2-2-3-6-2-3-2\">10.3<u data-kid=\"1-2-2-3-6-2-3-2-1\">K</u></div></div>\n<div class=\"cvc\" data-kid=\"1-2-2-3-6-2-4\"><div class=\"k\" data-kid=\"1-2-2-3-6-2-4-1\">Velocidad</div><div class=\"v\" data-kid=\"1-2-2-3-6-2-4-2\">1,489<u data-kid=\"1-2-2-3-6-2-4-2-1\">rpm</u></div></div>\n<div class=\"cvc\" data-kid=\"1-2-2-3-6-2-5\"><div class=\"k\" data-kid=\"1-2-2-3-6-2-5-1\">Torque</div><div class=\"v\" data-kid=\"1-2-2-3-6-2-5-2\">47.8<u data-kid=\"1-2-2-3-6-2-5-2-1\">Nm</u></div></div>\n<div class=\"cvc\" data-kid=\"1-2-2-3-6-2-6\"><div class=\"k\" data-kid=\"1-2-2-3-6-2-6-1\">Potencia</div><div class=\"v\" data-kid=\"1-2-2-3-6-2-6-2\">7,452<u data-kid=\"1-2-2-3-6-2-6-2-1\">W</u></div></div>\n<div class=\"cvc\" data-kid=\"1-2-2-3-6-2-7\"><div class=\"k\" data-kid=\"1-2-2-3-6-2-7-1\">Desgaste</div><div class=\"v\" data-kid=\"1-2-2-3-6-2-7-2\">212.5<u data-kid=\"1-2-2-3-6-2-7-2-1\">min</u></div></div>\n</div>\n</div>\n</section>\n<section class=\"sample\" data-kid=\"1-2-2-4\">\n<div class=\"sh\" data-kid=\"1-2-2-4-1\">\n<h3 data-kid=\"1-2-2-4-1-1\">Muestra seleccionada</h3>\n<span class=\"faint mono\" data-kid=\"1-2-2-4-1-2\" style=\"font-size:11px\">fila del cursor</span>\n</div>\n<div class=\"sgrid\" data-kid=\"1-2-2-4-2\">\n<span data-kid=\"1-2-2-4-2-1\">Hora</span><span data-kid=\"1-2-2-4-2-2\">Aire [K]</span><span data-kid=\"1-2-2-4-2-3\">Proceso [K]</span><span data-kid=\"1-2-2-4-2-4\">ΔT [K]</span><span data-kid=\"1-2-2-4-2-5\">Velocidad [rpm]</span><span data-kid=\"1-2-2-4-2-6\">Torque [Nm]</span><span data-kid=\"1-2-2-4-2-7\">Desgaste [min]</span><span data-kid=\"1-2-2-4-2-8\">Tipo</span>\n</div>\n<div class=\"srow2\" data-kid=\"1-2-2-4-3\">\n<span class=\"t\" data-kid=\"1-2-2-4-3-1\">23 nov 09:00</span><span data-kid=\"1-2-2-4-3-2\">301.3</span><span data-kid=\"1-2-2-4-3-3\">311.6</span><span data-kid=\"1-2-2-4-3-4\">10.3</span><span data-kid=\"1-2-2-4-3-5\">1,489</span><span data-kid=\"1-2-2-4-3-6\">47.8</span><span data-kid=\"1-2-2-4-3-7\">212.5</span><span class=\"type\" data-kid=\"1-2-2-4-3-8\">H</span>\n</div>\n</section>\n</div>\n</div>\n</div>",
      "comments": [],
      "created": "2026-11-23T01:45:08.094815+00:00",
