# ==========================================
# 1. DATABASE CONFIGURATION (PostgreSQL + pgvector)
# ==========================================
POSTGRES_USER=predict_user
POSTGRES_PASSWORD=predict_password
POSTGRES_DB=predictmain
POSTGRES_PORT=5432

# Database URL for Prisma ORM
DATABASE_URL="postgresql://predict_user:predict_password@localhost:5432/predictmain?schema=public"

# ==========================================
# 2. PYTHON ML SERVICE CONFIGURATION
# ==========================================
PYTHON_ML_SERVICE_URL="http://localhost:8000"
INTERNAL_API_KEY="dev-secret-key-change-this-in-production"
