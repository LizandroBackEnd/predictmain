      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n:root{\n  --bg:#F4F4F1; --panel:#FFFFFF; --raised:#FAFAF6; --sel:#E9E9E2;\n  --line:#DCDCD4; --line-strong:#BFBFB4;\n  --fg:#141414; --fg-2:#53585B; --fg-3:#6E7377;\n  --btn-bg:#141414; --btn-fg:#FFFFFF;\n  --crit:#A32A22; --crit-fill:rgba(163,42,34,.07);\n  --warn:#7A4E00; --warn-fill:rgba(122,78,0,.07);\n  --ok:#2C5F40;\n  --risk:#185C7D; --air:#185C7D; --proc:#8A5200; --rpm:#175B5B; --torque:#8B3F2C; --wear:#5A5A5A;\n  --grid:#E8E8E0; --band-fill:rgba(24,92,125,.055); --risk-fill:rgba(24,92,125,.16);\n}\n*{box-sizing:border-box;margin:0;padding:0;}\nbody{background:var(--bg);color:var(--fg);font-family:'Geist',system-ui,sans-serif;font-size:13px;-webkit-font-smoothing:antialiased;}\n.mono{font-family:'Geist Mono',monospace;font-feature-settings:\"tnum\" 1,\"zero\" 1;letter-spacing:-.01em;}\n.faint{color:var(--fg-3);} .muted{color:var(--fg-2);}\n.shell{display:flex;height:900px;overflow:hidden;}\n.side{width:176px;flex:0 0 176px;border-right:1px solid var(--line);display:flex;flex-direction:column;}\n.brand{height:56px;display:flex;align-items:center;gap:9px;padding:0 16px;border-bottom:1px solid var(--line);}\n.mark{width:22px;height:22px;border-radius:3px;background:var(--fg);color:var(--bg);display:grid;place-items:center;font-family:'Geist Mono',monospace;font-size:10px;font-weight:600;}\n.brand b{font-size:13px;font-weight:600;letter-spacing:-.015em;}\n.brand span{display:block;font-size:9.5px;letter-spacing:.09em;text-transform:uppercase;color:var(--fg-3);margin-top:2px;}\n.nav{padding:12px 8px;display:flex;flex-direction:column;gap:2px;}\n.nav a{display:flex;align-items:center;gap:10px;height:34px;padding:0 9px;border-radius:4px;color:var(--fg-2);text-decoration:none;font-size:13px;}\n.nav a i{font-size:15px;color:var(--fg-3);}\n.nav a.on{background:var(--sel);color:var(--fg);font-weight:500;}\n.nav a.on i{color:var(--fg);}\n.nav-label{font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--fg-3);padding:14px 9px 6px;}\n.sidefoot{margin-top:auto;padding:14px 16px 16px;border-top:1px solid var(--line);font-size:10.5px;color:var(--fg-3);line-height:1.5;}\n.main{flex:1;display:flex;flex-direction:column;min-width:0;}\n.top{height:56px;flex:0 0 56px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 20px;}\n.scope{display:flex;align-items:center;gap:10px;}\n.plant{display:flex;align-items:center;gap:8px;height:30px;padding:0 9px;border:1px solid var(--line);border-radius:4px;color:var(--fg);background:var(--panel);font:inherit;font-size:12.5px;font-weight:500;}\n.plant i{font-size:13px;color:var(--fg-2);}\n.vr{width:1px;height:16px;background:var(--line);}\n.topright{display:flex;align-items:center;gap:14px;}\n.stamp{font-size:11px;color:var(--fg-3);}\n.btn{display:inline-flex;align-items:center;gap:7px;height:32px;padding:0 11px;border-radius:4px;border:1px solid var(--line-strong);background:transparent;color:var(--fg);font:inherit;font-size:12.5px;cursor:pointer;white-space:nowrap;}\n.btn i{font-size:14px;color:var(--fg-2);}\n.btn.solid{background:var(--btn-bg);color:var(--btn-fg);border-color:var(--btn-bg);font-weight:500;}\n.btn.solid i{color:var(--btn-fg);opacity:.75;}\n.content{padding:20px;display:flex;flex-direction:column;gap:14px;flex:1;min-height:0;overflow:hidden;}\n.dot{width:6px;height:6px;border-radius:50%;display:inline-block;flex:0 0 6px;}\n.dot.crit{background:var(--crit);} .dot.warn{background:var(--warn);} .dot.ok{background:var(--ok);} .dot.none{background:var(--fg-3);}\n.cond{display:flex;align-items:center;gap:6px;padding:4px 8px;border:1px solid var(--crit);border-radius:3px;color:var(--crit);font-size:11px;background:var(--crit-fill);white-space:nowrap;}\n.crumb{font-size:10.5px;color:var(--fg-3);letter-spacing:.02em;}\n.ahead{display:flex;flex-direction:column;gap:7px;flex:0 0 auto;}\n.arow{display:flex;align-items:flex-start;justify-content:space-between;}\n.arow h1{font-size:22px;font-weight:600;letter-spacing:-.022em;line-height:1.1;}\n.meta{display:flex;gap:14px;margin-top:6px;font-size:11px;color:var(--fg-3);}\n.hact{display:flex;align-items:center;gap:8px;}\n.band{border:1px solid var(--line);border-radius:6px;background:var(--panel);display:grid;grid-template-columns:repeat(5,1fr);flex:0 0 auto;}\n.cell{padding:12px 16px 10px;border-left:1px solid var(--line);}\n.cell:first-child{border-left:none;}\n.crow{display:flex;align-items:baseline;justify-content:space-between;}\n.ck{font-size:9.5px;letter-spacing:.07em;text-transform:uppercase;color:var(--fg-3);}\n.ct{font-size:9px;color:var(--fg-3);font-family:'Geist Mono',monospace;}\n.cv{font-family:'Geist Mono',monospace;font-size:22px;font-weight:500;letter-spacing:-.03em;margin-top:5px;}\n.cv u{text-decoration:none;font-size:10px;color:var(--fg-3);margin-left:3px;letter-spacing:0;}\n.spark{display:block;margin-top:6px;}\n.panel{border:1px solid var(--line);border-radius:6px;background:var(--panel);padding:14px 20px 12px;display:flex;flex-direction:column;flex:1;min-height:0;}\n.ptool{display:flex;align-items:center;justify-content:space-between;height:38px;flex:0 0 auto;}\n.ptool .lbl{font-size:11.5px;color:var(--fg-2);}\n.ptool .lbl b{color:var(--fg);font-weight:500;}\n.ptools{display:flex;align-items:center;gap:12px;}\n.seg{display:flex;border:1px solid var(--line);border-radius:3px;overflow:hidden;}\n.seg span{padding:3px 8px;font-size:11px;color:var(--fg-3);font-family:'Geist Mono',monospace;}\n.seg span.on{background:var(--sel);color:var(--fg);}\n.sw{display:flex;align-items:center;gap:7px;font-size:11px;color:var(--fg-2);}\n.track{display:flex;align-items:flex-start;}\n.tlab{width:118px;flex:0 0 118px;padding-top:2px;}\n.tname{font-size:9.5px;letter-spacing:.07em;text-transform:uppercase;color:var(--fg-3);}\n.srow{display:flex;align-items:center;gap:6px;font-size:11px;color:var(--fg-2);margin-top:5px;}\n.srow .sw2{width:14px;height:0;border-top:2px solid var(--c);flex:0 0 14px;}\n.srow .sw2.dash{border-top-style:dashed;}\n.srow b{font-family:'Geist Mono',monospace;font-size:11px;color:var(--fg);font-weight:500;margin-left:auto;}\n.tlim{font-size:9.5px;color:var(--warn);margin-top:5px;font-family:'Geist Mono',monospace;}\n.tyaxis{width:38px;flex:0 0 38px;position:relative;height:72px;}\n.tyaxis span{position:absolute;right:7px;transform:translateY(-50%);font-family:'Geist Mono',monospace;font-size:8.5px;color:var(--fg-3);}\n.tplot{flex:1;min-width:0;}\n.tplot svg{display:block;width:100%;}\n.xaxis{display:flex;justify-content:space-between;margin-left:156px;font-family:'Geist Mono',monospace;font-size:9px;color:var(--fg-3);padding-top:2px;}\n.alerts{flex:0 0 auto;}\n.aheadrow{display:flex;align-items:center;justify-content:space-between;height:32px;}\n.aheadrow h3{font-size:13px;font-weight:600;letter-spacing:-.01em;}\n.link{font-size:11px;color:var(--fg-2);text-decoration:none;display:flex;align-items:center;gap:4px;}\n.link i{font-size:12px;color:var(--fg-3);}\n.atable{display:grid;grid-template-columns:64px 1fr 160px 150px 110px;align-items:center;padding:0 10px;height:32px;font-size:9.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--fg-3);border-bottom:1px solid var(--line-strong);}\n.atrow{display:grid;grid-template-columns:64px 1fr 160px 150px 110px;align-items:center;padding:0 10px;height:44px;border-bottom:1px solid var(--line);font-size:12px;}\n.atrow .t{font-family:'Geist Mono',monospace;font-size:11.5px;color:var(--fg-2);}\n.atrow .var{color:var(--fg);}\n.atrow .meas{font-family:'Geist Mono',monospace;font-size:12px;}\n.atrow .lim{font-family:'Geist Mono',monospace;font-size:11.5px;color:var(--fg-3);}\n.state{display:flex;align-items:center;gap:6px;font-size:11px;}\n.state.crit{color:var(--crit);} .state.warn{color:var(--warn);}\n</style>\n<div class=\"shell\" data-kid=\"1\">\n<aside class=\"side\" data-kid=\"1-1\">\n<div class=\"brand\" data-kid=\"1-1-1\"><div class=\"mark\" data-kid=\"1-1-1-1\">PM</div><div data-kid=\"1-1-1-2\"><b data-kid=\"1-1-1-2-1\">PredictMain</b><span data-kid=\"1-1-1-2-2\">Mantenimiento</span></div></div>\n<nav class=\"nav\" data-kid=\"1-1-2\">\n<div class=\"nav-label\" data-kid=\"1-1-2-1\">Operación</div>\n<a data-kid=\"1-1-2-2\" href=\"#\"><i class=\"icon-list-ordered\" data-kid=\"1-1-2-2-1\"></i>Operación</a>\n<a class=\"on\" data-kid=\"1-1-2-3\" href=\"#\"><i class=\"icon-factory\" data-kid=\"1-1-2-3-1\"></i>Activos</a>\n<a data-kid=\"1-1-2-4\" href=\"#\"><i class=\"icon-chart-no-axes-combined\" data-kid=\"1-1-2-4-1\"></i>Telemetría</a>\n<a data-kid=\"1-1-2-5\" href=\"#\"><i class=\"icon-triangle-alert\" data-kid=\"1-1-2-5-1\"></i>Riesgo de falla</a>\n<a data-kid=\"1-1-2-6\" href=\"#\"><i class=\"icon-book-open\" data-kid=\"1-1-2-6-1\"></i>Base de conocimiento</a>\n</nav>\n<div class=\"sidefoot\" data-kid=\"1-1-3\">Modelo activo<br data-kid=\"1-1-3-1\"/><span class=\"mono\" data-kid=\"1-1-3-2\" style=\"color:var(--fg-2)\">random_forest</span></div>\n</aside>\n<div class=\"main\" data-kid=\"1-2\">\n<header class=\"top\" data-kid=\"1-2-1\">\n<div class=\"scope\" data-kid=\"1-2-1-1\">\n<button class=\"plant\" data-kid=\"1-2-1-1-1\"><i class=\"icon-factory\" data-kid=\"1-2-1-1-1-1\"></i>Planta Norte<i class=\"icon-chevron-down\" data-kid=\"1-2-1-1-1-2\"></i></button>\n<div class=\"vr\" data-kid=\"1-2-1-1-2\"></div>\n<span class=\"faint\" data-kid=\"1-2-1-1-3\" style=\"font-size:11.5px\">Fresado y torneado</span>\n</div>\n<div class=\"topright\" data-kid=\"1-2-1-2\">\n<span class=\"stamp mono\" data-kid=\"1-2-1-2-1\">Lecturas hasta 23 nov 13:04</span>\n<button class=\"btn\" data-kid=\"1-2-1-2-2\"><i class=\"icon-book-open\" data-kid=\"1-2-1-2-2-1\"></i>Asistente técnico</button>\n</div>\n</header>\n<div class=\"content\" data-kid=\"1-2-2\">\n<div class=\"ahead\" data-kid=\"1-2-2-1\">\n<div class=\"crumb mono\" data-kid=\"1-2-2-1-1\">Activos / Línea 1 / FR-204</div>\n<div class=\"arow\" data-kid=\"1-2-2-1-2\">\n<div data-kid=\"1-2-2-1-2-1\">\n<h1 data-kid=\"1-2-2-1-2-1-1\">Fresadora Cincinnati 4</h1>\n<div class=\"meta\" data-kid=\"1-2-2-1-2-1-2\"><span data-kid=\"1-2-2-1-2-1-2-1\">Fresado vertical</span><span data-kid=\"1-2-2-1-2-1-2-2\">Tipo H</span><span data-kid=\"1-2-2-1-2-1-2-3\">Instalada mar 2019</span><span data-kid=\"1-2-2-1-2-1-2-4\">Planta Norte</span></div>\n</div>\n<div class=\"hact\" data-kid=\"1-2-2-1-2-2\">\n<div class=\"cond\" data-kid=\"1-2-2-1-2-2-1\"><span class=\"dot crit\" data-kid=\"1-2-2-1-2-2-1-1\"></span>Crítico</div>\n<button class=\"btn\" data-kid=\"1-2-2-1-2-2-2\">Ver telemetría</button>\n<button class=\"btn solid\" data-kid=\"1-2-2-1-2-2-3\">Riesgo de falla<i class=\"icon-arrow-up-right\" data-kid=\"1-2-2-1-2-2-3-1\"></i></button>\n<button class=\"btn\" data-kid=\"1-2-2-1-2-2-4\">Ficha técnica</button>\n</div>\n</div>\n</div>\n<section class=\"band\" data-kid=\"1-2-2-2\">\n<div class=\"cell\" data-kid=\"1-2-2-2-1\">\n<div class=\"crow\" data-kid=\"1-2-2-2-1-1\"><span class=\"ck\" data-kid=\"1-2-2-2-1-1-1\">Temp. aire</span><span class=\"ct\" data-kid=\"1-2-2-2-1-1-2\">13:02</span></div>\n<div class=\"cv\" data-kid=\"1-2-2-2-1-2\">302.4<u data-kid=\"1-2-2-2-1-2-1\">K</u></div>\n<svg class=\"spark\" data-kid=\"1-2-2-2-1-3\" height=\"44\" preserveaspectratio=\"none\" viewbox=\"0 0 152 44\" width=\"208\">\n<path d=\"M3 34 L9 34 L16 32 L22 26 L28 31 L34 28 L41 30 L47 31 L53 27 L59 23 L66 22 L72 25 L78 21 L84 20 L91 17 L97 16 L103 20 L109 14 L116 13 L122 15 L128 11 L134 14 L141 14 L147 12\" fill=\"none\" stroke=\"var(--air)\" stroke-width=\"1.4\"></path>\n<circle cx=\"147\" cy=\"12\" fill=\"var(--air)\" r=\"2\"></circle>\n</svg>\n</div>\n<div class=\"cell\" data-kid=\"1-2-2-2-2\">\n<div class=\"crow\" data-kid=\"1-2-2-2-2-1\"><span class=\"ck\" data-kid=\"1-2-2-2-2-1-1\">Temp. proceso</span><span 