stroke=\"var(--grid)\" x1=\"0\" x2=\"1010\" y1=\"48\" y2=\"48\"></line>\n<line stroke=\"var(--line-strong)\" x1=\"0\" x2=\"1010\" y1=\"88\" y2=\"88\"></line>\n<line opacity=\".5\" stroke=\"var(--fg-3)\" stroke-width=\"1\" x1=\"851\" x2=\"851\" y1=\"0\" y2=\"96\"></line>\n<line opacity=\".6\" stroke=\"var(--crit)\" stroke-dasharray=\"4 4\" stroke-width=\"1\" x1=\"0\" x2=\"1010\" y1=\"13.3\" y2=\"13.3\"></line>\n<path d=\"M0 84 L11 83 L21 82 L32 81 L43 81 L53 80 L64 79 L74 79 L85 78 L96 77 L106 77 L117 76 L128 75 L138 75 L149 74 L159 73 L170 72 L181 72 L191 71 L202 70 L213 70 L223 69 L234 68 L245 68 L255 67 L266 66 L276 65 L287 64 L298 64 L308 63 L319 62 L330 62 L340 61 L351 61 L361 60 L372 60 L383 59 L393 58 L404 57 L415 56 L425 56 L436 55 L447 55 L457 54 L468 53 L478 53 L489 52 L500 51 L510 51 L521 50 L532 50 L542 49 L553 48 L563 48 L574 47 L585 46 L595 45 L606 45 L617 44 L627 43 L638 43 L649 42 L659 41 L670 40 L680 40 L691 39 L702 38 L712 37 L723 36 L734 36 L744 35 L755 34 L765 33 L776 33 L787 32 L797 32 L808 31 L819 30 L829 29 L840 29 L851 28 L861 27 L872 27 L882 26 L893 26 L904 25 L914 24 L925 23 L936 23 L946 22 L957 21 L967 21 L978 20 L989 20 L999 19 L1010 18\" fill=\"none\" stroke=\"var(--wear)\" stroke-width=\"1.6\"></path>\n<circle cx=\"851\" cy=\"28\" fill=\"var(--wear)\" r=\"3\" stroke=\"var(--panel)\" stroke-width=\"1.5\"></circle>\n</svg>\n</div>\n</div>\n<div class=\"xaxis\" data-kid=\"1-2-2-3-5\" data-name=\"shared x-axis time scale\">\n<span data-kid=\"1-2-2-3-5-1\" data-name=\"x-axis time label 13:00\">13:00</span><span data-kid=\"1-2-2-3-5-2\" data-name=\"x-axis time label 17:00\">17:00</span><span data-kid=\"1-2-2-3-5-3\" data-name=\"x-axis time label 21:00\">21:00</span><span data-kid=\"1-2-2-3-5-4\" data-name=\"x-axis time label 01:00\">01:00</span><span data-kid=\"1-2-2-3-5-5\" data-name=\"x-axis time label 05:00\">05:00</span><span data-kid=\"1-2-2-3-5-6\" data-name=\"x-axis time label 09:00\">09:00</span><span data-kid=\"1-2-2-3-5-7\" data-name=\"x-axis time label 13:00\">13:00</span>\n</div>\n<div class=\"cursorbar\" data-kid=\"1-2-2-3-6\" data-name=\"cursor readout bar\">\n<div class=\"curlab\" data-kid=\"1-2-2-3-6-1\" data-name=\"cursor position label\">Muestra en cursor<b data-kid=\"1-2-2-3-6-1-1\" data-name=\"cursor timestamp value\">23 nov 09:00</b></div>\n<div class=\"cv\" data-kid=\"1-2-2-3-6-2\" data-name=\"cursor value grid\">\n<div class=\"cvc\" data-kid=\"1-2-2-3-6-2-1\" data-name=\"air temperature value cell\"><div class=\"k\" data-kid=\"1-2-2-3-6-2-1-1\" data-name=\"air temperature metric label\">Aire</div><div class=\"v\" data-kid=\"1-2-2-3-6-2-1-2\" data-name=\"air temperature value\">301.3<u data-kid=\"1-2-2-3-6-2-1-2-1\" data-name=\"air temperature unit\">K</u></div></div>\n<div class=\"cvc\" data-kid=\"1-2-2-3-6-2-2\" data-name=\"process temperature value cell\"><div class=\"k\" data-kid=\"1-2-2-3-6-2-2-1\" data-name=\"process temperature metric label\">Proceso</div><div class=\"v\" data-kid=\"1-2-2-3-6-2-2-2\" data-name=\"process temperature value\">311.6<u data-kid=\"1-2-2-3-6-2-2-2-1\" data-name=\"process temperature unit\">K</u></div></div>\n<div class=\"cvc\" data-kid=\"1-2-2-3-6-2-3\" data-name=\"temperature delta value cell\"><div class=\"k\" data-kid=\"1-2-2-3-6-2-3-1\" data-name=\"temperature delta metric label\">ΔT</div><div class=\"v\" data-kid=\"1-2-2-3-6-2-3-2\" data-name=\"temperature delta value\">10.3<u data-kid=\"1-2-2-3-6-2-3-2-1\" data-name=\"temperature delta unit\">K</u></div></div>\n<div class=\"cvc\" data-kid=\"1-2-2-3-6-2-4\" data-name=\"speed value cell\"><div class=\"k\" data-kid=\"1-2-2-3-6-2-4-1\" data-name=\"speed metric label\">Velocidad</div><div class=\"v\" data-kid=\"1-2-2-3-6-2-4-2\" data-name=\"speed value\">1,489<u data-kid=\"1-2-2-3-6-2-4-2-1\" data-name=\"speed unit\">rpm</u></div></div>\n<div class=\"cvc\" data-kid=\"1-2-2-3-6-2-5\" data-name=\"torque value cell\"><div class=\"k\" data-kid=\"1-2-2-3-6-2-5-1\" data-name=\"torque metric label\">Torque</div><div class=\"v\" data-kid=\"1-2-2-3-6-2-5-2\" data-name=\"torque value\">47.8<u data-kid=\"1-2-2-3-6-2-5-2-1\" data-name=\"torque unit\">Nm</u></div></div>\n<div class=\"cvc\" data-kid=\"1-2-2-3-6-2-6\" data-name=\"power value cell\"><div class=\"k\" data-kid=\"1-2-2-3-6-2-6-1\" data-name=\"power metric label\">Potencia</div><div class=\"v\" data-kid=\"1-2-2-3-6-2-6-2\" data-name=\"power value\">7,452<u data-kid=\"1-2-2-3-6-2-6-2-1\" data-name=\"power unit\">W</u></div></div>\n<div class=\"cvc\" data-kid=\"1-2-2-3-6-2-7\" data-name=\"wear value cell\"><div class=\"k\" data-kid=\"1-2-2-3-6-2-7-1\" data-name=\"wear metric label\">Desgaste</div><div class=\"v\" data-kid=\"1-2-2-3-6-2-7-2\" data-name=\"wear value\">212.5<u data-kid=\"1-2-2-3-6-2-7-2-1\" data-name=\"wear unit\">min</u></div></div>\n</div>\n</div>\n</section>\n<section class=\"sample\" data-kid=\"1-2-2-4\" data-name=\"selected sample section\">\n<div class=\"sh\" data-kid=\"1-2-2-4-1\" data-name=\"sample section header\">\n<h3 data-kid=\"1-2-2-4-1-1\" data-name=\"sample section title\">Muestra seleccionada</h3>\n<span class=\"faint mono\" data-kid=\"1-2-2-4-1-2\" data-name=\"cursor row annotation\" style=\"font-size:11px\">fila del cursor</span>\n</div>\n<div class=\"sgrid\" data-kid=\"1-2-2-4-2\" data-name=\"sample table header row\">\n<span data-kid=\"1-2-2-4-2-1\" data-name=\"column header Hora\">Hora</span><span data-kid=\"1-2-2-4-2-2\" data-name=\"column header Aire K\">Aire [K]</span><span data-kid=\"1-2-2-4-2-3\" data-name=\"column header Proceso K\">Proceso [K]</span><span data-kid=\"1-2-2-4-2-4\" data-name=\"column header delta T K\">ΔT [K]</span><span data-kid=\"1-2-2-4-2-5\" data-name=\"column header Velocidad rpm\">Velocidad [rpm]</span><span data-kid=\"1-2-2-4-2-6\" data-name=\"column header Torque Nm\">Torque [Nm]</span><span data-kid=\"1-2-2-4-2-7\" data-name=\"column header Desgaste min\">Desgaste [min]</span><span data-kid=\"1-2-2-4-2-8\" data-name=\"column header Tipo\">Tipo</span>\n</div>\n<div class=\"srow2\" data-kid=\"1-2-2-4-3\" data-name=\"sample data row\">\n<span class=\"t\" data-kid=\"1-2-2-4-3-1\" data-name=\"sample timestamp cell\">23 nov 09:00</span><span data-kid=\"1-2-2-4-3-2\" data-name=\"sample air temperature cell\">301.3</span><span data-kid=\"1-2-2-4-3-3\" data-name=\"sample process temperature cell\">311.6</span><span data-kid=\"1-2-2-4-3-4\" data-name=\"sample temperature delta cell\">10.3</span><span data-kid=\"1-2-2-4-3-5\" data-name=\"sample speed cell\">1,489</span><span data-kid=\"1-2-2-4-3-6\" data-name=\"sample torque cell\">47.8</span><span data-kid=\"1-2-2-4-3-7\" data-name=\"sample wear cell\">212.5</span><span class=\"type\" data-kid=\"1-2-2-4-3-8\" data-name=\"sample type cell\">H</span>\n</div>\n</section>\n</div>\n</div>\n</div>",
