    "var_04affa0f8760": {
      "type": "variant",
      "label": "Telemetría — explorador de sensores (oscuro)",
      "parentId": "var_06d6f557c7d4",
      "themeId": null,
      "rect": {
        "x": 4620,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n:root{\n  --bg:#0B0C0D; --panel:#131416; --raised:#1B1D1F; --sel:#272B2E;\n  --line:#2B2F32; --line-strong:#3C4246;\n  --fg:#ECECEA; --fg-2:#A6ACB1; --fg-3:#767D82;\n  --btn-bg:#ECECEA; --btn-fg:#0B0C0D;\n  --crit:#F08D80; --crit-fill:rgba(240,141,128,.10);\n  --warn:#E3A954; --warn-fill:rgba(227,169,84,.10);\n  --ok:#79B58E;\n  --risk:#7FBAE0; --air:#7FBAE0; --proc:#E8AE69; --rpm:#77B6B5; --torque:#E5998A; --wear:#B6B6B6;\n  --grid:#242829; --band-fill:rgba(127,186,224,.055); --risk-fill:rgba(127,186,224,.20);\n}\n*{box-sizing:border-box;margin:0;padding:0;}\nbody{background:var(--bg);color:var(--fg);font-family:'Geist',system-ui,sans-serif;font-size:13px;-webkit-font-smoothing:antialiased;}\n.mono{font-family:'Geist Mono',monospace;font-feature-settings:\"tnum\" 1,\"zero\" 1;letter-spacing:-.01em;}\n.faint{color:var(--fg-3);} .muted{color:var(--fg-2);}\n.shell{display:flex;height:900px;overflow:hidden;}\n.side{width:176px;flex:0 0 176px;border-right:1px solid var(--line);display:flex;flex-direction:column;}\n.brand{height:56px;display:flex;align-items:center;gap:9px;padding:0 16px;border-bottom:1px solid var(--line);}\n.mark{width:22px;height:22px;border-radius:3px;background:var(--fg);color:var(--bg);display:grid;place-items:center;font-family:'Geist Mono',monospace;font-size:10px;font-weight:600;}\n.brand b{font-size:13px;font-weight:600;letter-spacing:-.015em;}\n.brand span{display:block;font-size:9.5px;letter-spacing:.09em;text-transform:uppercase;color:var(--fg-3);margin-top:2px;}\n.nav{padding:12px 8px;display:flex;flex-direction:column;gap:2px;}\n.nav a{display:flex;align-items:center;gap:10px;height:34px;padding:0 9px;border-radius:4px;color:var(--fg-2);text-decoration:none;font-size:13px;}\n.nav a i{font-size:15px;color:var(--fg-3);}\n.nav a.on{background:var(--sel);color:var(--fg);font-weight:500;}\n.nav a.on i{color:var(--fg);}\n.nav-label{font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--fg-3);padding:14px 9px 6px;}\n.sidefoot{margin-top:auto;padding:14px 16px 16px;border-top:1px solid var(--line);font-size:10.5px;color:var(--fg-3);line-height:1.5;}\n.main{flex:1;display:flex;flex-direction:column;min-width:0;}\n.top{height:56px;flex:0 0 56px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 20px;}\n.scope{display:flex;align-items:center;gap:10px;}\n.plant{display:flex;align-items:center;gap:8px;height:30px;padding:0 9px;border:1px solid var(--line);border-radius:4px;color:var(--fg);background:var(--panel);font:inherit;font-size:12.5px;font-weight:500;}\n.plant i{font-size:13px;color:var(--fg-2);}\n.vr{width:1px;height:16px;background:var(--line);}\n.topright{display:flex;align-items:center;gap:14px;}\n.stamp{font-size:11px;color:var(--fg-3);}\n.btn{display:inline-flex;align-items:center;gap:7px;height:32px;padding:0 11px;border-radius:4px;border:1px solid var(--line-strong);background:transparent;color:var(--fg);font:inherit;font-size:12.5px;cursor:pointer;white-space:nowrap;}\n.btn i{font-size:14px;color:var(--fg-2);}\n.btn.solid{background:var(--btn-bg);color:var(--btn-fg);border-color:var(--btn-bg);font-weight:500;}\n.ctl{display:flex;align-items:center;gap:7px;height:32px;padding:0 10px;border:1px solid var(--line);border-radius:4px;background:var(--panel);font-size:12px;color:var(--fg-2);white-space:nowrap;}\n.ctl b{color:var(--fg);font-weight:500;}\n.ctl i{font-size:12px;color:var(--fg-3);}\n.content{padding:20px;display:flex;flex-direction:column;gap:14px;flex:1;min-height:0;overflow:hidden;}\n.vhead{display:flex;align-items:flex-end;justify-content:space-between;flex:0 0 auto;}\n.vhead h1{font-size:22px;font-weight:600;letter-spacing:-.022em;}\n.vhead h1 em{font-style:normal;color:var(--fg-3);font-weight:400;font-size:13px;letter-spacing:0;margin-left:10px;}\n.toolbar{display:flex;align-items:center;justify-content:space-between;flex:0 0 auto;}\n.tleft,.tright{display:flex;align-items:center;gap:8px;}\n.seg{display:flex;border:1px solid var(--line);border-radius:3px;overflow:hidden;height:32px;align-items:center;}\n.seg span{padding:0 10px;font-size:11.5px;color:var(--fg-3);font-family:'Geist Mono',monospace;display:flex;align-items:center;height:100%;}\n.seg span.on{background:var(--sel);color:var(--fg);}\n.sw{display:flex;align-items:center;gap:8px;font-size:11.5px;color:var(--fg-2);height:32px;padding:0 2px;}\n.panel{border:1px solid var(--line);border-radius:6px;background:var(--panel);padding:16px 20px 14px;display:flex;flex-direction:column;flex:1;min-height:0;}\n.track{display:flex;align-items:flex-start;}\n.tlab{width:118px;flex:0 0 118px;padding-top:2px;}\n.tname{font-size:9.5px;letter-spacing:.07em;text-transform:uppercase;color:var(--fg-3);}\n.srow{display:flex;align-items:center;gap:6px;font-size:11px;color:var(--fg-2);margin-top:6px;}\n.srow .sw2{width:14px;height:0;border-top:2px solid var(--c);flex:0 0 14px;}\n.srow .sw2.dash{border-top-style:dashed;} .srow .sw2.dotd{border-top-style:dotted;}\n.tlim{font-size:9.5px;font-family:'Geist Mono',monospace;margin-top:6px;}\n.tyaxis{width:38px;flex:0 0 38px;position:relative;height:96px;}\n.tyaxis span{position:absolute;right:7px;transform:translateY(-50%);font-family:'Geist Mono',monospace;font-size:8.5px;color:var(--fg-3);letter-spacing:-.02em;}\n.tyaxis s{position:absolute;right:0;width:4px;border-top:1px solid var(--line-strong);text-decoration:none;}\n.tplot{flex:1;min-width:0;}\n.tplot svg{display:block;width:100%;}\n.xaxis{display:flex;justify-content:space-between;margin-left:156px;font-family:'Geist Mono',monospace;font-size:9px;color:var(--fg-3);padding-top:2px;}\n.cursorbar{display:flex;align-items:center;margin-top:auto;border-top:1px solid var(--line);padding-top:12px;}\n.curlab{width:156px;flex:0 0 156px;font-size:9.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--fg-3);}\n.curlab b{display:block;font-family:'Geist Mono',monospace;font-size:12px;color:var(--fg);letter-spacing:0;margin-top:3px;text-transform:none;}\n.cv{display:grid;grid-template-columns:repeat(7,1fr);flex:1;}\n.cvc .k{font-size:9.5px;letter-spacing:.05em;text-transform:uppercase;color:var(--fg-3);}\n.cvc .v{font-family:'Geist Mono',monospace;font-size:14px;margin-top:4px;letter-spacing:-.02em;}\n.cvc .v u{text-decoration:none;font-size:9.5px;color:var(--fg-3);margin-left:2px;}\n.sample{flex:0 0 auto;}\n.sh{display:flex;align-items:center;justify-content:space-between;height:32px;}\n.sh h3{font-size:12.5px;font-weight:600;letter-spacing:-.01em;}\n.sgrid{display:grid;grid-template-columns:140px 118px 128px 96px 138px 118px 138px 1fr;align-items:center;padding:0 10px;height:32px;font-size:9.5px;letter-spacing:.07em;text-transform:uppercase;color:var(--fg-3);border-bottom:1px solid var(--line-strong);}\n.srow2{display:grid;grid-template-columns:140px 118px 128px 96px 138px 118px 138px 1fr;align-items:center;padding:0 10px;height:44px;border-bottom:1px solid var(--line);font-family:'Geist Mono',monospace;font-size:12px;}\n.srow2 .t{color:var(--fg-2);} .srow2 .type{font-size:10px;color:var(--fg-3);}\n</style>\n<div class=\"shell\" data-kid=\"1\" data-name=\"page layout container\">\n<aside class=\"side\" data-kid=\"1-1\" data-name=\"sidebar navigation column\">\n<div class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand identity header\"><div class=\"mark\" data-kid=\"1-1-1-1\" data-name=\"brand logo mark\">PM</div><div data-kid=\"1-1-1-2\" data-name=\"brand text block\"><b data-kid=\"1-1-1-2-1\" data-name=\"brand product name\">PredictMain</b><span data-kid=\"1-1-1-2-2\" data-name=\"brand subtitle text\">Mantenimiento</span></div></div>\n<nav class=\"nav\" data-kid=\"1-1-2\" data-name=\"side navigation menu\">\n<div class=\"nav-label\" data-kid=\"1-1-2-1\" data-nam