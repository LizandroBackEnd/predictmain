    "var_c6b72f520eba": {
      "type": "variant",
      "label": "Asistente técnico — panel RAG (oscuro)",
      "parentId": "var_ad439194beb0",
      "themeId": null,
      "rect": {
        "x": 7700,
        "y": 0,
        "w": 480,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n:root{\n  --bg:#0B0C0D; --panel:#131416; --raised:#1B1D1F; --sel:#272B2E;\n  --line:#2B2F32; --line-strong:#3C4246;\n  --fg:#ECECEA; --fg-2:#A6ACB1; --fg-3:#767D82;\n  --btn-bg:#ECECEA; --btn-fg:#0B0C0D;\n  --crit:#F08D80; --crit-fill:rgba(240,141,128,.10);\n  --warn:#E3A954; --warn-fill:rgba(227,169,84,.10);\n  --ok:#79B58E;\n  --risk:#7FBAE0; --air:#7FBAE0; --proc:#E8AE69; --rpm:#77B6B5; --torque:#E5998A; --wear:#B6B6B6;\n  --grid:#242829; --band-fill:rgba(127,186,224,.055); --risk-fill:rgba(127,186,224,.20);\n}\n*{box-sizing:border-box;margin:0;padding:0;}\nbody{background:var(--bg);color:var(--fg);font-family:'Geist',system-ui,sans-serif;font-size:13px;-webkit-font-smoothing:antialiased;}\n.mono{font-family:'Geist Mono',monospace;font-feature-settings:\"tnum\" 1;letter-spacing:-.01em;}\n.faint{color:var(--fg-3);} .muted{color:var(--fg-2);}\n.stage{height:900px;display:flex;align-items:stretch;justify-content:flex-end;padding:0;}\n.sheet{width:440px;background:var(--panel);border-left:1px solid var(--line-strong);display:flex;flex-direction:column;height:100%;}\n/* header */\n.shead{height:64px;flex:0 0 64px;display:flex;align-items:center;justify-content:space-between;padding:0 18px;border-bottom:1px solid var(--line);}\n.shead h2{font-size:14px;font-weight:600;letter-spacing:-.012em;}\n.shead .sub{font-size:10.5px;color:var(--fg-3);margin-top:3px;}\n.iconbtn{width:28px;height:28px;display:grid;place-items:center;border:1px solid var(--line);border-radius:4px;color:var(--fg-2);background:transparent;cursor:pointer;}\n.iconbtn i{font-size:14px;}\n/* context */\n.ctx{flex:0 0 auto;padding:12px 18px;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:11px;background:var(--bg);}\n.ctx .ic{width:28px;height:28px;border:1px solid var(--line);border-radius:3px;display:grid;place-items:center;color:var(--fg-2);flex:0 0 28px;}\n.ctx .ic i{font-size:14px;}\n.ctx .l1{font-size:12px;font-weight:500;}\n.ctx .l1 span{font-family:'Geist Mono',monospace;font-size:10.5px;color:var(--fg-3);margin-left:6px;font-weight:400;}\n.ctx .l2{font-size:10px;color:var(--fg-3);margin-top:3px;}\n.ctx .l2 b{color:var(--fg-2);font-weight:400;font-family:'Geist Mono',monospace;}\n/* thread */\n.thread{flex:1;min-height:0;padding:18px 18px 8px;display:flex;flex-direction:column;gap:18px;overflow:hidden;}\n.q{align-self:flex-end;max-width:330px;background:var(--sel);border-radius:6px 6px 2px 6px;padding:10px 12px;font-size:12.5px;line-height:1.45;}\n.q .who{font-size:9.5px;letter-spacing:.07em;text-transform:uppercase;color:var(--fg-3);margin-bottom:5px;}\n.a .gen{display:flex;align-items:center;gap:7px;font-size:9.5px;letter-spacing:.07em;text-transform:uppercase;color:var(--fg-3);margin-bottom:8px;}\n.a .gen i{font-size:12px;}\n.a p{font-size:12.5px;line-height:1.55;color:var(--fg);}\n.a p+p{margin-top:8px;}\n.a p b{font-weight:600;}\n.srclabel{font-size:9.5px;letter-spacing:.07em;text-transform:uppercase;color:var(--fg-3);margin:14px 0 8px;}\n.src{display:flex;align-items:flex-start;gap:10px;border:1px solid var(--line);border-radius:4px;padding:10px 11px;background:var(--raised);margin-bottom:8px;}\n.src .ic{color:var(--fg-2);flex:0 0 auto;margin-top:1px;}\n.src .ic i{font-size:14px;}\n.src .body{flex:1;min-width:0;}\n.src .t{font-size:12px;font-weight:500;letter-spacing:-.005em;}\n.src .m{font-size:10px;color:var(--fg-3);margin-top:4px;font-family:'Geist Mono',monospace;}\n.src .m b{color:var(--fg-2);font-weight:400;}\n.src .sim{font-family:'Geist Mono',monospace;font-size:10px;color:var(--fg-3);flex:0 0 auto;margin-top:1px;}\n.src .chev{align-self:center;color:var(--fg-3);}\n.src .chev i{font-size:13px;}\n.note{font-size:10.5px;color:var(--fg-3);display:flex;align-items:center;gap:6px;margin-top:2px;}\n.note i{font-size:12px;}\n/* composer */\n.comp{flex:0 0 auto;border-top:1px solid var(--line);padding:14px 18px 16px;background:var(--panel);}\n.inp{border:1px solid var(--line-strong);border-radius:5px;background:var(--bg);padding:10px 11px;min-height:52px;display:flex;align-items:flex-start;}\n.inp span{font-size:12.5px;color:var(--fg-3);line-height:1.4;}\n.crow{display:flex;align-items:center;justify-content:space-between;margin-top:10px;}\n.ctxchip{display:flex;align-items:center;gap:6px;font-size:10.5px;color:var(--fg-3);}\n.ctxchip i{font-size:12px;}\n.ctxchip b{font-family:'Geist Mono',monospace;color:var(--fg-2);font-weight:400;}\n.btn{display:inline-flex;align-items:center;gap:7px;height:32px;padding:0 12px;border-radius:4px;border:1px solid var(--btn-bg);background:var(--btn-bg);color:var(--btn-fg);font:inherit;font-size:12.5px;font-weight:500;cursor:pointer;}\n.btn i{font-size:14px;opacity:.75;}\n</style>\n<div class=\"stage\" data-kid=\"1\" data-name=\"page layout stage container\">\n<aside class=\"sheet\" data-kid=\"1-1\" data-name=\"technical assistant side panel\">\n<header class=\"shead\" data-kid=\"1-1-1\" data-name=\"panel header bar\">\n<div data-kid=\"1-1-1-1\" data-name=\"panel title group\">\n<h2 data-kid=\"1-1-1-1-1\" data-name=\"panel headline title\">Asistente técnico</h2>\n<div class=\"sub\" data-kid=\"1-1-1-1-2\" data-name=\"panel subtitle description\">Manuales y registros de servicio</div>\n</div>\n<button class=\"iconbtn\" data-kid=\"1-1-1-2\" data-name=\"close panel icon button\"><i class=\"icon-x\" data-kid=\"1-1-1-2-1\" data-name=\"close (X) icon\"></i></button>\n</header>\n<div class=\"ctx\" data-kid=\"1-1-2\" data-name=\"active context banner\">\n<div class=\"ic\" data-kid=\"1-1-2-1\" data-name=\"asset icon container\"><i class=\"icon-factory\" data-kid=\"1-1-2-1-1\" data-name=\"factory icon\"></i></div>\n<div data-kid=\"1-1-2-2\" data-name=\"context text block\" style=\"min-width:0\">\n<div class=\"l1\" data-kid=\"1-1-2-2-1\" data-name=\"asset name line\">Fresadora Cincinnati 4<span data-kid=\"1-1-2-2-1-1\" data-name=\"asset ID code\">FR-204</span></div>\n<div class=\"l2\" data-kid=\"1-1-2-2-2\" data-name=\"shift time range line\">Línea 1, Fresado — 22 nov 13:00 a 23 nov 13:00</div>\n</div>\n</div>\n<div class=\"thread\" data-kid=\"1-1-3\" data-name=\"conversation thread container\">\n<div class=\"q\" data-kid=\"1-1-3-1\" data-name=\"question bubble\">\n<div class=\"who\" data-kid=\"1-1-3-1-1\" data-name=\"question label\">Pregunta</div>\n        ¿Qué inspección corresponde si el desgaste supera los 220 min en una fresadora tipo H?\n      </div>\n<div class=\"a\" data-kid=\"1-1-3-2\" data-name=\"assistant answer block\">\n<div class=\"gen\" data-kid=\"1-1-3-2-1\" data-name=\"generated answer label\"><i class=\"icon-file-text\" data-kid=\"1-1-3-2-1-1\" data-name=\"document file icon\"></i>Respuesta generada</div>\n<p data-kid=\"1-1-3-2-2\" data-name=\"answer paragraph about wear threshold\">Para tipo H, el manual fija el cambio de herramienta al alcanzar <b data-kid=\"1-1-3-2-2-1\" data-name=\"highlighted threshold value\">240 min</b> de desgaste acumulado. Entre 220 y 240 min indica inspección visual del filo y medición de torque antes de continuar el ciclo.</p>\n<p data-kid=\"1-1-3-2-3\" data-name=\"answer paragraph about torque\">Si el torque supera <b data-kid=\"1-1-3-2-3-1\" data-name=\"highlighted torque value\">61 Nm</b> con desgaste alto, el procedimiento pide detener el ciclo y registrar la intervención en la bitácora del activo.</p>\n<div class=\"srclabel\" data-kid=\"1-1-3-2-4\" data-name=\"source list label row\" style=\"display:flex;align-items:center;justify-content:space-between\">Fuentes<span data-kid=\"1-1-3-2-4-1\" data-name=\"source count and similarity text\" style=\"font-family:'Geist Mono',monospace;letter-spacing:0;text-transform:none;font-size:9.5px\">2 fragmentos, similitud 0.81 o más</span></div>\n<div class=\"src\" data-kid=\"1-1-3-2-5\" data-name=\"source item card\">\n<div class=\"ic\" data-kid=\"1-1-3-2-5-1\" data-name=\"source icon container\"><i class=\"icon-file-text\" data-kid=\"1-1-3-2-5-1-1\" data-name=\"manual document icon\"></i></div>\n<div class=\"body\" data-kid=\"1-1-3-2-5-2\" data-name=\"source text body\">\n<div class=\"t\" data-kid=\"1-1-3-2-5-2-1\" data-name=\"source document title\">Manual de mantenimiento — fresadora vertical</div>\n<div class=\"m\" data-kid=\"1-1-3-2-5-2-2\" data-name=\"source reference metadata line\">Sección 4.3, pág. 27 <b data-kid=\"1-1-3-2-5-2-2-1\" data-name=\"revision code value\">rev. 2019-03</b></div>\n</div>\n<div class=\"chev\" data-kid=\"1-1-3-2-5-3\" data-name=\"source arrow icon container\"><i class=\"icon-chevron-right\" data-kid=\"1-1-3-2-5-3-1\" data-name=\"chevron right arrow icon\"></i></div>\n</div>\n<div class=\"src\" data-kid=\"1-1-3-2-6\" data-name=\"source item card\">\n<div class=\"ic\" data-kid=\"1-1-3-2-6-1\" data-name=\"source icon container\"><i class=\"icon-clipboard-list\" data-kid=\"1-1-3-2-6-1-1\" data-name=\"service log clipboard icon\"></i></div>\n<div class=\"body\" data-kid=\"1-1-3-2-6-2\" data-name=\"source text body\">\n<div class=\"t\" data-kid=\"1-1-3-2-6-2-1\" data-name=\"source document title\">Registro de servicio — FR-204</div>\n<div class=\"m\" data-kid=\"1-1-3-2-6-2-2\" data-name=\"service log metadata line\">Cambio de herramienta, 12 ago 2026 <b data-kid=\"1-1-3-2-6-2-2-1\" data-name=\"wear minutes value\">228 min</b></div>\n</div>\n<div class=\"chev\" data-kid=\"1-1-3-2-6-3\" data-name=\"source arrow icon container\"><i class=\"icon-chevron-right\" data-kid=\"1-1-3-2-6-3-1\" data-name=\"chevron right arrow icon\"></i></div>\n</div>\n</div>\n</div>\n<div class=\"comp\" data-kid=\"1-1-4\" data-name=\"message composer area\">\n<div class=\"inp\" data-kid=\"1-1-4-1\" data-name=\"question input field\"><span data-kid=\"1-1-4-1-1\" data-name=\"input placeholder text\">Pregunta sobre el manual o este activo</span></div>\n<div class=\"crow\" data-kid=\"1-1-4-2\" data-name=\"composer action row\">\n<div class=\"ctxchip\" data-kid=\"1-1-4-2-1\" data-name=\"context chip indicator\"><i class=\"icon-link\" data-kid=\"1-1-4-2-1-1\" data-name=\"link chain icon\"></i>Contexto <b data-kid=\"1-1-4-2-1-2\" data-name=\"asset ID in context chip\">FR-204</b></div>\n<button class=\"btn\" data-kid=\"1-1-4-2-2\" data-name=\"send question button\">Enviar pregunta<i class=\"icon-arrow-up\" data-kid=\"1-1-4-2-2-1\" data-name=\"up arrow send icon\"></i></button>\n</div>\n</div>\n</aside>\n</div>",
