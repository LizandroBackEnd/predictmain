ata-kid=\"1-2-2-3-3-1\" data-name=\"torque axis label column\">\n<div class=\"tname\" data-kid=\"1-2-2-3-3-1-1\" data-name=\"torque track title\">Torque [Nm]</div>\n<div class=\"srow\" data-kid=\"1-2-2-3-3-1-2\" data-name=\"applied torque series legend row\" style=\"--c:var(--torque)\"><span class=\"sw2\" data-kid=\"1-2-2-3-3-1-2-1\" data-name=\"solid line swatch\"></span><span data-kid=\"1-2-2-3-3-1-2-2\" data-name=\"applied torque series legend label\">Par aplicado</span></div>\n<div class=\"tlim\" data-kid=\"1-2-2-3-3-1-3\" data-name=\"torque limit text\" style=\"color:var(--warn)\">límite 61.0</div>\n</div>\n<div class=\"tyaxis\" data-kid=\"1-2-2-3-3-2\" data-name=\"torque y-axis scale\"><span data-kid=\"1-2-2-3-3-2-1\" data-name=\"y-axis value 70\" style=\"top:8px\">70</span><span data-kid=\"1-2-2-3-3-2-2\" data-name=\"y-axis value 50\" style=\"top:48px\">50</span><span data-kid=\"1-2-2-3-3-2-3\" data-name=\"y-axis value 30\" style=\"top:88px\">30</span></div>\n<div class=\"tplot\" data-kid=\"1-2-2-3-3-3\" data-name=\"torque plot area\">\n<svg data-kid=\"1-2-2-3-3-3-1\" data-name=\"torque SVG chart\" height=\"96\" viewbox=\"0 0 1024 96\">\n<line stroke=\"var(--grid)\" x1=\"0\" x2=\"1010\" y1=\"8\" y2=\"8\"></line>\n<line stroke=\"var(--grid)\" x1=\"0\" x2=\"1010\" y1=\"48\" y2=\"48\"></line>\n<line stroke=\"var(--line-strong)\" x1=\"0\" x2=\"1010\" y1=\"88\" y2=\"88\"></line>\n<line opacity=\".5\" stroke=\"var(--fg-3)\" stroke-width=\"1\" x1=\"851\" x2=\"851\" y1=\"0\" y2=\"96\"></line>\n<line opacity=\".6\" stroke=\"var(--warn)\" stroke-dasharray=\"4 4\" stroke-width=\"1\" x1=\"0\" x2=\"1010\" y1=\"26\" y2=\"26\"></line>\n<path d=\"M0 71 L11 71 L21 72 L32 69 L43 71 L53 70 L64 69 L74 70 L85 68 L96 69 L106 70 L117 69 L128 69 L138 70 L149 68 L159 70 L170 67 L181 68 L191 70 L202 70 L213 69 L223 67 L234 70 L245 68 L255 69 L266 67 L276 67 L287 67 L298 69 L308 67 L319 68 L330 66 L340 68 L351 66 L361 66 L372 66 L383 66 L393 66 L404 67 L415 68 L425 65 L436 67 L447 69 L