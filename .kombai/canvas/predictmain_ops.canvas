 fill=\"var(--crit)\" r=\"3.2\"></circle>\n<circle cx=\"1010\" cy=\"131\" fill=\"var(--crit)\" r=\"3.2\"></circle>\n<circle cx=\"1081\" cy=\"76\" fill=\"var(--crit)\" r=\"3.2\"></circle>\n<line opacity=\".7\" stroke=\"var(--line-strong)\" stroke-dasharray=\"2 3\" stroke-width=\"1\" x1=\"1116\" x2=\"1116\" y1=\"49\" y2=\"320\"></line>\n<circle cx=\"1116\" cy=\"49\" fill=\"none\" opacity=\".35\" r=\"9\" stroke=\"var(--risk)\"></circle>\n<circle cx=\"1116\" cy=\"49\" fill=\"var(--risk)\" r=\"4\"></circle>\n</svg>\n</div>\n</div>\n<div class=\"xaxis\" data-kid=\"1-2-2-3-3\" data-name=\"chart x-axis time labels\">\n<span data-kid=\"1-2-2-3-3-1\" data-name=\"x-axis time 13:00\">13:00</span><span data-kid=\"1-2-2-3-3-2\" data-name=\"x-axis time 17:00\">17:00</span><span data-kid=\"1-2-2-3-3-3\" data-name=\"x-axis time 21:00\">21:00</span><span data-kid=\"1-2-2-3-3-4\" data-name=\"x-axis time 01:00\">01:00</span><span data-kid=\"1-2-2-3-3-5\" data-name=\"x-axis time 05:00\">05:00</span><span data-kid=\"1-2-2-3-3-6\" data-name=\"x-axis time 09:00\">09:00</span><span data-kid=\"1-2-2-3-3-7\" data-name=\"x-axis time 13:00\">13:00</span>\n</div>\n</section>\n<section class=\"action\" data-kid=\"1-2-2-4\" data-name=\"recommended action strip\">\n<div class=\"ic\" data-kid=\"1-2-2-4-1\" data-name=\"wrench icon in action strip\"><i class=\"icon-wrench\" data-kid=\"1-2-2-4-1-1\" data-name=\"wrench icon\"></i></div>\n<div class=\"txt\" data-kid=\"1-2-2-4-2\" data-name=\"action text block\">\n<div class=\"t1\" data-kid=\"1-2-2-4-2-1\" data-name=\"action headline inspect torque and wear\">Inspeccionar torque y desgaste de herramienta</div>\n<div class=\"t2\" data-kid=\"1-2-2-4-2-2\" data-name=\"action procedure reference line\">Procedimiento <b data-kid=\"1-2-2-4-2-2-1\" data-name=\"procedure code MP-OSF-03\">MP-OSF-03</b> — regla OSF: torque × desgaste <b data-kid=\"1-2-2-4-2-2-2\" data-name=\"torque-desert value 14414\">14,414 Nm·min</b>, límite 13,000 para tipo H</div>\n</div>\n<button class=\"btn solid\" data-kid=\"1-2-2-4-3\" data-name=\"view procedure CTA button\">Ver procedimiento<i class=\"icon-arrow-up-right\" data-kid=\"1-2-2-4-3-1\" data-name=\"arrow-up-right icon in CTA\"></i></button>\n</section>\n<section class=\"evid\" data-kid=\"1-2-2-5\" data-name=\"estimation inputs evidence section\">\n<div class=\"sh\" data-kid=\"1-2-2-5-1\" data-name=\"evidence section header\"><h3 data-kid=\"1-2-2-5-1-1\" data-name=\"evidence section title Estimation inputs\">Entradas de la estimación</h3><span class=\"faint mono\" data-kid=\"1-2-2-5-1-2\" data-name=\"evidence timestamp\" style=\"font-size:10.5px\">23 nov 13:02</span></div>\n<div class=\"evfields\" data-kid=\"1-2-2-5-2\" data-name=\"evidence metric fields grid\">\n<div class=\"evf\" data-kid=\"1-2-2-5-2-1\" data-name=\"evidence field Air\"><div class=\"k\" data-kid=\"1-2-2-5-2-1-1\" data-name=\"evidence field label Air\">Aire</div><div class=\"v\" data-kid=\"1-2-2-5-2-1-2\" data-name=\"evidence field value Air 302.4\">302.4<u data-kid=\"1-2-2-5-2-1-2-1\" data-name=\"evidence field unit K\">K</u></div></div>\n<div class=\"evf\" data-kid=\"1-2-2-5-2-2\" data-name=\"evidence field Process\"><div class=\"k\" data-kid=\"1-2-2-5-2-2-1\" data-name=\"evidence field label Process\">Proceso</div><div class=\"v\" data-kid=\"1-2-2-5-2-2-2\" data-name=\"evidence field value Process 312.8\">312.8<u data-kid=\"1-2-2-5-2-2-2-1\" data-name=\"evidence field unit K\">K</u></div></div>\n<div class=\"evf\" data-kid=\"1-2-2-5-2-3\" data-name=\"evidence field ΔT\"><div class=\"k\" data-kid=\"1-2-2-5-2-3-1\" data-name=\"evidence field label ΔT\">ΔT</div><div class=\"v\" data-kid=\"1-2-2-5-2-3-2\" data-name=\"evidence field value ΔT 10.4\">10.4<u data-kid=\"1-2-2-5-2-3-2-1\" data-name=\"evidence field unit K\">K</u></div></div>\n<div class=\"evf\" data-kid=\"1-2-2-5-2-4\" data-name=\"evidence field Speed\"><div class=\"k\" data-kid=\"1-2-2-5-2-4-1\" data-name=\"evidence field label Speed\">Velocidad</div><div class=\"v\" data-kid=\"1-2-2-5-2-4-2\" data-name=\"evidence field value Speed 1421\">1,421<u data-kid=\"1-2-2-5-2-4-2-1\" data-name=\"evidence field unit rpm\">rpm</u></div></div>\n<div class=\"evf\" data-kid=\"1-2-2-5-2-5\" data-name=\"evidence field Torque\"><div class=\"k\" data-kid=\"1-2-2-5-2-5-1\" data-name=\"evidence field label Torque\">Torque</div><div class=\"v\" data-kid=\"1-2-2-5-2-5-2\" data-name=\"evidence field value Torque 62.4\">62.4<u data-kid=\"1-2-2-5-2-5-2-1\" data-name=\"evidence field unit Nm\">Nm</u></div></div>\n<div class=\"evf\" data-kid=\"1-2-2-5-2-6\" data-name=\"evidence field Wear\"><div class=\"k\" data-kid=\"1-2-2-5-2-6-1\" data-name=\"evidence field label Wear\">Desgaste</div><div class=\"v\" data-kid=\"1-2-2-5-2-6-2\" data-name=\"evidence field value Wear 231\">231<u data-kid=\"1-2-2-5-2-6-2-1\" data-name=\"evidence field unit min\">min</u></div></div>\n<div class=\"evf\" data-kid=\"1-2-2-5-2-7\" data-name=\"evidence field Power\"><div class=\"k\" data-kid=\"1-2-2-5-2-7-1\" data-name=\"evidence field label Power\">Potencia</div><div class=\"v\" data-kid=\"1-2-2-5-2-7-2\" data-name=\"evidence field value Power 9286\">9,286<u data-kid=\"1-2-2-5-2-7-2-1\" data-name=\"evidence field unit W\">W</u></div></div>\n<div class=\"evf\" data-kid=\"1-2-2-5-2-8\" data-name=\"evidence field Type\"><div class=\"k\" data-kid=\"1-2-2-5-2-8-1\" data-name=\"evidence field label Type\">Tipo</div><div class=\"v\" data-kid=\"1-2-2-5-2-8-2\" data-name=\"evidence field value Type H\">H</div></div>\n</div>\n</section>\n<section class=\"eval\" data-kid=\"1-2-2-6\" data-name=\"model comparison evaluation section\">\n<div class=\"epanel\" data-kid=\"1-2-2-6-1\" data-name=\"model comparison table panel\">\n<h3 data-kid=\"1-2-2-6-1-1\" data-name=\"model comparison title\">Comparación de modelos</h3>\n<div class=\"sub\" data-kid=\"1-2-2-6-1-2\" data-name=\"model comparison subtitle\">Conjunto de prueba, 2,500 registros, partición 75 / 25 estratificada</div>\n<table class=\"mtable\" data-kid=\"1-2-2-6-1-3\" data-name=\"model comparison table\">\n<tr data-kid=\"1-2-2-6-1-3-1\" data-name=\"model comparison table header row\"><th data-kid=\"1-2-2-6-1-3-1-1\" data-name=\"column header Model\">Modelo</th><th data-kid=\"1-2-2-6-1-3-1-2\" data-name=\"column header Precision\">Precisión</th><th data-kid=\"1-2-2-6-1-3-1-3\" data-name=\"column header Recall\">Recall</th><th data-kid=\"1-2-2-6-1-3-1-4\" data-name=\"column header F1\">F1</th><th data-kid=\"1-2-2-6-1-3-1-5\" data-name=\"column header ROC-AUC\">ROC-AUC</th></tr>\n<tr data-kid=\"1-2-2-6-1-3-2\" data-name=\"model row logistic regression\"><td data-kid=\"1-2-2-6-1-3-2-1\" data-name=\"model cell logistic_regression\">logistic_regression</td><td data-kid=\"1-2-2-6-1-3-2-2\" data-name=\"cell precision 0.1411\">0.1411</td><td data-kid=\"1-2-2-6-1-3-2-3\" data-name=\"cell recall 0.8118\">0.8118</td><td data-kid=\"1-2-2-6-1-3-2-4\" data-name=\"cell F1 0.2404\">0.2404</td><td data-kid=\"1-2-2-6-1-3-2-5\" data-name=\"cell ROC-AUC 0.8836\">0.8836</td></tr>\n<tr class=\"sel\" data-kid=\"1-2-2-6-1-3-3\" data-name=\"model row random forest (selected)\"><td data-kid=\"1-2-2-6-1-3-3-1\" data-name=\"model cell random_forest\">random_forest</td><td data-kid=\"1-2-2-6-1-3-3-2\" data-name=\"cell precision 0.7901\">0.7901</td><td data-kid=\"1-2-2-6-1-3-3-3\" data-name=\"cell recall 0.7529\">0.7529</td><td data-kid=\"1-2-2-6-1-3-3-4\" data-name=\"cell F1 0.7711\">0.7711</td><td data-kid=\"1-2-2-6-1-3-3-5\" data-name=\"cell ROC-AUC 0.9703\">0.9703</td></tr>\n</table>\n<div class=\"sub\" data-kid=\"1-2-2-6-1-4\" data-name=\"model selection footnote\" style=\"margin-top:14px\">Selección por mayor F1; desempate por recall. Modelo serializado en <span class=\"mono\" data-kid=\"1-2-2-6-1-4-1\" data-name=\"serialized model filename in mono\" style=\"color:var(--fg-2)\">modelo.joblib</span>.</div>\n</div>\n<div class=\"epanel\" data-kid=\"1-2-2-6-2\" data-name=\"failure modes panel\">\n<h3 data-kid=\"1-2-2-6-2-1\" data-name=\"failure modes title\">Modos de falla registrados</h3>\n<div class=\"sub\" data-kid=\"1-2-2-6-2-2\" data-name=\"failure modes subtitle\">AI4I 2020, 10,000 registros etiquetados</div>\n<div class=\"hbars\" data-kid=\"1-2-2-6-2-3\" data-name=\"failure modes horizontal bar chart\">\n<div class=\"hb\" data-kid=\"1-2-2-6-2-3-1\" data-name=\"bar row HDF heat 115\"><span class=\"m\" data-kid=\"1-2-2-6-2-3-1-1\" data-name=\"bar label HDF with heat sub\">HDF<u data-kid=\"1-2-2-6-2-3-1-1-1\" data-name=\"bar sublabel heat\">calor</u></span><span class=\"track\" data-kid=\"1-2-2-6-2-3-1-2\" data-name=\"bar track\"><span class=\"fill\" data-kid=\"1-2-2-6-2-3-1-2-1\" data-name=\"bar fill 96%\" style=\"width:96%\"></span></span><span class=\"n\" data-kid=\"1-2-2-6-2-3-1-3\" data-name=\"bar count value 115\">115</span></div>\n<div class=\"hb\" data-kid=\"1-2-2-6-2-3-2\" data-name=\"bar row OSF effort 98\"><span class=\"m\" data-kid=\"1-2-2-6-2-3-2-1\" data-name=\"bar label OSF with effort sub\">OSF<u data-kid=\"1-2-2-6-2-3-2-1-1\" data-name=\"bar sublabel effort\">esfuerzo</u></span><span class=\"track\" data-kid=\"1-2-2-6-2-3-2-2\" data-name=\"bar track\"><span class=\"fill\" data-kid=\"1-2-2-6-2-3-2-2-1\" data-name=\"bar fill 82%\" style=\"width:82%\"></span></span><span class=\"n\" data-kid=\"1-2-2-6-2-3-2-3\" data-name=\"bar count value 98\">98</span></div>\n<div class=\"hb\" data-kid=\"1-2-2-6-2-3-3\" data-name=\"bar row PWF power 95\"><span class=\"m\" data-kid=\"1-2-2-6-2-3-3-1\" data-name=\"bar label PWF with power sub\">PWF<u data-kid=\"1-2-2-6-2-3-3-1-1\" data-name=\"bar sublabel power\">potencia</u></span><span class=\"track\" data-kid=\"1-2-2-6-2-3-3-2\" data-name=\"bar track\"><span class=\"fill\" data-kid=\"1-2-2-6-2-3-3-2-1\" data-name=\"bar fill 79%\" style=\"width:79%\"></span></span><span class=\"n\" data-kid=\"1-2-2-6-2-3-3-3\" data-name=\"bar count value 95\">95</span></div>\n<div class=\"hb\" data-kid=\"1-2-2-6-2-3-4\" data-name=\"bar row TWF wear 46\"><span class=\"m\" data-kid=\"1-2-2-6-2-3-4-1\" data-name=\"bar label TWF with wear sub\">TWF<u data-kid=\"1-2-2-6-2-3-4-1-1\" data-name=\"bar sublabel wear\">desgaste</u></span><span class=\"track\" data-kid=\"1-2-2-6-2-3-4-2\" data-name=\"bar track\"><span class=\"fill\" data-kid=\"1-2-2-6-2-3-4-2-1\" data-name=\"bar fill 38%\" style=\"width:38%\"></span></span><span class=\"n\" data-kid=\"1-2-2-6-2-3-4-3\" data-name=\"bar count value 46\">46</span></div>\n<div class=\"hb\" data-kid=\"1-2-2-6-2-3-5\" data-name=\"bar row RNF random 19\"><span class=\"m\" data-kid=\"1-2-2-6-2-3-5-1\" data-name=\"bar label RNF with random sub\">RNF<u data-kid=\"1-2-2-6-2-3-5-1-1\" data-name=\"bar sublabel random\">aleatoria</u></span><span class=\"track\" data-kid=\"1-2-2-6-2-3-5-2\" data-name=\"bar track\"><span class=\"fill\" data-kid=\"1-2-2-6-2-3-5-2-1\" data-name=\"bar fill 16%\" style=\"width:16%\"></span></span><span class=\"n\" data-kid=\"1-2-2-6-2-3-5-3\" data-name=\"bar count value 19\">19</span></div>\n<div class=\"scale\" data-kid=\"1-2-2-6-2-3-6\" data-name=\"bar chart scale footer\"><span data-kid=\"1-2-2-6-2-3-6-1\" data-name=\"scale left spacer\"></span><span class=\"ruler\" data-kid=\"1-2-2-6-2-3-6-2\" data-name=\"scale ruler line\"><span data-kid=\"1-2-2-6-2-3-6-2-1\" data-name=\"scale tick 0\">0</span><span data-kid=\"1-2-2-6-2-3-6-2-2\" data-name=\"scale tick 60\">60</span><span data-kid=\"1-2-2-6-2-3-6-2-3\" data-name=\"scale tick 120 registros\">120 registros</span></span><span data-kid=\"1-2-2-6-2-3-6-3\" data-name=\"scale right spacer\"></span></div>\n</div>\n</div>\n</section>\n</div>\n</div>\n</div>",
