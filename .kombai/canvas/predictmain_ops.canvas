      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n:root{\n  --bg:#F4F4F1; --panel:#FFFFFF; --raised:#FAFAF6; --sel:#E9E9E2;\n  --line:#DCDCD4; --line-strong:#BFBFB4;\n  --fg:#141414; --fg-2:#53585B; --fg-3:#6E7377;\n  --btn-bg:#141414; --btn-fg:#FFFFFF;\n  --crit:#A32A22; --crit-fill:rgba(163,42,34,.07);\n  --warn:#7A4E00; --warn-fill:rgba(122,78,0,.07);\n  --ok:#2C5F40;\n  --risk:#185C7D; --air:#185C7D; --proc:#8A5200; --rpm:#175B5B; --torque:#8B3F2C; --wear:#5A5A5A;\n  --grid:#E8E8E0; --band-fill:rgba(24,92,125,.055); --risk-fill:rgba(24,92,125,.16);\n}\n*{box-sizing:border-box;margin:0;padding:0;}\nbody{background:var(--bg);color:var(--fg);font-family:'Geist',system-ui,sans-serif;font-size:13px;-webkit-font-smoothing:antialiased;}\n.mono{font-family:'Geist Mono',monospace;font-feature-settings:\"tnum\" 1;letter-spacing:-.01em;}\n.faint{color:var(--fg-3);} .muted{color:var(--fg-2);}\n.stage{height:900px;display:flex;align-items:stretch;justify-content:flex-end;}\n.sheet{width:440px;background:var(--panel);border-left:1px solid var(--line-strong);display:flex;flex-direction:column;height:100%;}\n.shead{height:64px;flex:0 0 64px;display:flex;align-items:center;justify-content:space-between;padding:0 18px;border-bottom:1px solid var(--line);}\n.shead h2{font-size:14px;font-weight:600;letter-spacing:-.012em;}\n.shead .sub{font-size:10.5px;color:var(--fg-3);margin-top:3px;}\n.iconbtn{width:28px;height:28px;display:grid;place-items:center;border:1px solid var(--line);border-radius:4px;color:var(--fg-2);background:transparent;cursor:pointer;}\n.iconbtn i{font-size:14px;}\n.ctx{flex:0 0 auto;padding:12px 18px;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:11px;background:var(--bg);}\n.ctx .ic{width:28px;height:28px;border:1px solid var(--line);border-radius:3px;display:grid;place-items:center;color:var(--fg-2);flex:0 0 28px;}\n.ctx .ic i{font-size:14px;}\n.ctx .l1{font-size:12px;font-weight:500;}\n.ctx .l1 span{font-family:'Geist Mono',monospace;font-size:10.5px;color:var(--fg-3);margin-left:6px;font-weight:400;}\n.ctx .l2{font-size:10px;color:var(--fg-3);margin-top:3px;}\n.thread{flex:1;min-height:0;padding:18px 18px 8px;display:flex;flex-direction:column;gap:18px;overflow:hidden;}\n.q{align-self:flex-end;max-width:330px;background:var(--sel);border-radius:6px 6px 2px 6px;padding:10px 12px;font-size:12.5px;line-height:1.45;}\n.q .who{font-size:9.5px;letter-spacing:.07em;text-transform:uppercase;color:var(--fg-3);margin-bottom:5px;}\n.a .gen{display:flex;align-items:center;gap:7px;font-size:9.5px;letter-spacing:.07em;text-transform:uppercase;color:var(--fg-3);margin-bottom:8px;}\n.a .gen i{font-size:12px;}\n.a p{font-size:12.5px;line-height:1.55;color:var(--fg);}\n.a p+p{margin-top:8px;}\n.a p b{font-weight:600;}\n.srclabel{font-size:9.5px;letter-spacing:.07em;text-transform:uppercase;color:var(--fg-3);margin:14px 0 8px;}\n.src{display:flex;align-items:flex-start;gap:10px;border:1px solid var(--line);border-radius:4px;padding:10px 11px;background:var(--raised);margin-bottom:8px;}\n.src .ic{color:var(--fg-2);flex:0 0 auto;margin-top:1px;}\n.src .ic i{font-size:14px;}\n.src .body{flex:1;min-width:0;}\n.src .t{font-size:12px;font-weight:500;letter-spacing:-.005em;}\n.src .m{font-size:10px;color:var(--fg-3);margin-top:4px;font-family:'Geist Mono',monospace;}\n.src .m b{color:var(--fg-2);font-weight:400;}\n.src .chev{align-self:center;color:var(--fg-3);}\n.src .chev i{font-size:13px;}\n.comp{flex:0 0 auto;border-top:1px solid var(--line);padding:14px 18px 16px;background:var(--panel);}\n.inp{border:1px solid var(--line-strong);border-radius:5px;background:var(--bg);padding:10px 11px;min-height:52px;display:flex;align-items:flex-start;}\n.inp span{font-size:12.5px;color:var(--fg-3);line-height:1.4;}\n.crow{display:flex;align-items:center;justify-content:space-between;margin-top:10px;}\n.ctxchip{display:flex;align-items:center;gap:6px;font-size:10.5px;color:var(--fg-3);}\n.ctxchip i{font-size:12px;}\n.ctxchip b{font-family:'Geist Mono',monospace;color:var(--fg-2);font-weight:400;}\n.btn{display:inline-flex;align-items:center;gap:7px;height:32px;padding:0 12px;border-radius:4px;border:1px solid var(--btn-bg);background:var(--btn-bg);color:var(--btn-fg);font:inherit;font-size:12.5px;font-weight:500;cursor:pointer;}\n.btn i{font-size:14px;opacity:.75;}\n</style>\n<div class=\"stage\" data-kid=\"1\" data-name=\"page stage container\">\n<aside class=\"sheet\" data-kid=\"1-1\" data-name=\"technical assistant side panel\">\n<header class=\"shead\" data-kid=\"1-1-1\" data-name=\"panel header bar\">\n<div data-kid=\"1-1-1-1\" data-name=\"header title group\">\n<h2 data-kid=\"1-1-1-1-1\" data-name=\"panel title text\">Asistente técnico</h2>\n<div class=\"sub\" data-kid=\"1-1-1-1-2\" data-name=\"panel subtitle text\">Manuales y registros de servicio</div>\n</div>\n<button class=\"iconbtn\" data-kid=\"1-1-1-2\" data-name=\"panel close button\"><i class=\"icon-x\" data-kid=\"1-1-1-2-1\" data-name=\"close X icon\"></i></button>\n</header>\n<div class=\"ctx\" data-kid=\"1-1-2\" data-name=\"active asset context bar\">\n<div class=\"ic\" data-kid=\"1-1-2-1\" data-name=\"context icon container\"><i class=\"icon-factory\" data-kid=\"1-1-2-1-1\" data-name=\"factory machine icon\"></i></div>\n<div data-kid=\"1-1-2-2\" data-name=\"asset context text group\" style=\"min-width:0\">\n<div class=\"l1\" data-kid=\"1-1-2-2-1\" data-name=\"asset name with code\">Fresadora Cincinnati 4<span data-kid=\"1-1-2-2-1-1\" data-name=\"asset code label\">FR-204</span></div>\n<div class=\"l2\" data-kid=\"1-1-2-2-2\" data-name=\"asset shift schedule line\">Línea 1, Fresado — 22 nov 13:00 a 23 nov 13:00</div>\n</div>\n</div>\n<div class=\"thread\" data-kid=\"1-1-3\" data-name=\"conversation thread area\">\n<div class=\"q\" data-kid=\"1-1-3-1\" data-name=\"user question bubble\">\n<div class=\"who\" data-kid=\"1-1-3-1-1\" data-name=\"question speaker label\">Pregunta</div>\n        ¿Qué inspección corresponde si el desgaste supera los 220 min en una fresadora tipo H?\n      </div>\n<div class=\"a\" data-kid=\"1-1-3-2\" data-name=\"assistant answer block\">\n<div class=\"gen\" data-kid=\"1-1-3-2-1\" data-name=\"generated answer label\"><i class=\"icon-file-text\" data-kid=\"1-1-3-2-1-1\" data-name=\"file text icon\"></i>Respuesta generada</div>\n<p data-kid=\"1-1-3-2-2\" data-name=\"answer paragraph about tool change\">Para tipo H, el manual fija el cambio de herramienta al alcanzar <b data-kid=\"1-1-3-2-2-1\" data-name=\"highlighted threshold value\">240 min</b> de desgaste acumulado. Entre 220 y 240 min indica inspección visual del filo y medición de torque antes de continuar el ciclo.</p>\n<p data-kid=\"1-1-3-2-3\" data-name=\"answer paragraph about torque check\">Si el torque supera <b data-kid=\"1-1-3-2-3-1\" data-name=\"highlighted torque value\">61 Nm</b> con desgaste alto, el procedimiento pide detener el ciclo y registrar la intervención en la bitácora del activo.</p>\n<div class=\"srclabel\" data-kid=\"1-1-3-2-4\" data-name=\"source list header row\" style=\"display:flex;align-items:center;justify-content:space-between\">Fuentes<span data-kid=\"1-1-3-2-4-1\" data-name=\"source count and similarity note\" style=\"font-family:'Geist Mono',monospace;letter-spacing:0;text-transform:none;font-size:9.5px\">2 fragmentos, similitud 0.81 o más</span></div>\n<div class=\"src\" data-kid=\"1-1-3-2-5\" data-name=\"source citation card container\">\n<div class=\"ic\" data-kid=\"1-1-3-2-5-1\" data-name=\"source card icon container\"><i class=\"icon-file-text\" data-kid=\"1-1-3-2-5-1-1\" data-name=\"manual file icon\"></i></div>\n<div class=\"body\" data-kid=\"1-1-3-2-5-2\" data-name=\"source card text body\">\n<div class=\"t\" data-kid=\"1-1-3-2-5-2-1\" data-name=\"source document title\">Manual de mantenimiento — fresadora vertical</div>\n<div class=\"m\" data-kid=\"1-1-3-2-5-2-2\" data-name=\"source section and revision detail\">Sección 4.3, pág. 27 <b data-kid=\"1-1-3-2-5-2-2-1\" data-name=\"revision date value\">rev. 2019-03</b></div>\n</div>\n<div class=\"chev\" data-kid=\"1-1-3-2-5-3\" data-name=\"source card expand chevron\"><i class=\"icon-chevron-right\" data-kid=\"1-1-3-2-5-3-1\" data-name=\"right chevron icon\"></i></div>\n</div>\n<div class=\"src\" data-kid=\"1-1-3-2-6\" data-name=\"source citation card container\">\n<div class=\"ic\" data-kid=\"1-1-3-2-6-1\" data-name=\"source card icon container\"><i class=\"icon-clipboard-list\" data-kid=\"1-1-3-2-6-1-1\" data-name=\"clipboard list icon\"></i></div>\n<div class=\"body\" data-kid=\"1-1-3-2-6-2\" data-name=\"source card text body\">\n<div class=\"t\" data-kid=\"1-1-3-2-6-2-1\" data-name=\"service log record title\">Registro de servicio — FR-204</div>\n<div class=\"m\" data-kid=\"1-1-3-2-6-2-2\" data-name=\"service log event detail\">Cambio de herramienta, 12 ago 2026 <b data-kid=\"1-1-3-2-6-2-2-1\" data-name=\"wear duration value\">228 min</b></div>\n</div>\n<div class=\"chev\" data-kid=\"1-1-3-2-6-3\" data-name=\"source card expand chevron\"><i class=\"icon-chevron-right\" data-kid=\"1-1-3-2-6-3-1\" data-name=\"right chevron icon\"></i></div>\n</div>\n</div>\n</div>\n<div class=\"comp\" data-kid=\"1-1-4\" data-name=\"composer input section\">\n<div class=\"inp\" data-kid=\"1-1-4-1\" data-name=\"question input field\"><span data-kid=\"1-1-4-1-1\" data-name=\"question input placeholder text\">Pregunta sobre el manual o este activo</span></div>\n<div class=\"crow\" data-kid=\"1-1-4-2\" data-name=\"action row\">\n<div class=\"ctxchip\" data-kid=\"1-1-4-2-1\" data-name=\"context chip\"><i class=\"icon-link\" data-kid=\"1-1-4-2-1-1\" data-name=\"link icon\"></i>Contexto <b data-kid=\"1-1-4-2-1-2\" data-name=\"context chip asset code\">FR-204</b></div>\n<button class=\"btn\" data-kid=\"1-1-4-2-2\" data-name=\"send question button\">Enviar pregunta<i class=\"icon-arrow-up\" data-kid=\"1-1-4-2-2-1\" data-name=\"up arrow send icon\"></i></button>\n</div>\n</div>\n</aside>\n</div>",
