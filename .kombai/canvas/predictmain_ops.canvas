      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n:root{\n  --bg:#0B0C0D; --panel:#131416; --raised:#1B1D1F; --sel:#272B2E;\n  --line:#2B2F32; --line-strong:#3C4246;\n  --fg:#ECECEA; --fg-2:#A6ACB1; --fg-3:#767D82;\n  --btn-bg:#ECECEA; --btn-fg:#0B0C0D;\n  --crit:#F08D80; --crit-fill:rgba(240,141,128,.10);\n  --warn:#E3A954; --warn-fill:rgba(227,169,84,.10);\n  --ok:#79B58E;\n  --risk:#7FBAE0; --air:#7FBAE0; --proc:#E8AE69; --rpm:#77B6B5; --torque:#E5998A; --wear:#B6B6B6;\n  --grid:#242829; --band-fill:rgba(127,186,224,.055); --risk-fill:rgba(127,186,224,.20);\n}\n*{box-sizing:border-box;margin:0;padding:0;}\nbody{background:var(--bg);color:var(--fg);font-family:'Geist',system-ui,sans-serif;font-size:13px;-webkit-font-smoothing:antialiased;}\n.mono{font-family:'Geist Mono',monospace;font-feature-settings:\"tnum\" 1;letter-spacing:-.01em;}\n.faint{color:var(--fg-3);}\n.wrap{padding:20px;display:flex;flex-direction:column;gap:12px;height:680px;box-sizing:border-box;}\n.h{display:flex;align-items:flex-end;justify-content:space-between;height:36px;}\n.h h1{font-size:17px;font-weight:600;letter-spacing:-.02em;}\n.h span{font-size:11px;color:var(--fg-3);}\n.panel{border:1px solid var(--line);border-radius:6px;background:var(--panel);padding:12px 16px;display:flex;flex-direction:column;gap:6px;height:186px;}\n.ptop{display:flex;align-items:center;justify-content:space-between;height:22px;}\n.ptop .t{font-size:11px;color:var(--fg-2);}\n.ptop .t b{color:var(--fg);font-weight:500;}\n.chart{display:flex;flex:1;min-height:0;}\n.gut{width:34px;flex:0 0 34px;position:relative;font-family:'Geist Mono',monospace;font-size:8.5px;color:var(--fg-3);}\n.gut span{position:absolute;right:6px;transform:translateY(-50%);}\n.plot{flex:1;min-width:0;position:relative;}\n.plot svg{display:block;width:100%;height:100%;}\n/* skeleton */\n.sk{position:absolute;background:var(--grid);border-radius:3px;}\n.sk.line{height:2px;}\n.sk.box{background:var(--raised);}\n.lblsk{display:inline-block;height:8px;border-radius:2px;background:var(--grid);}\n/* empty */\n.empty{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;}\n.empty .e1{font-size:12px;color:var(--fg-2);}\n.empty .e2{font-size:10.5px;color:var(--fg-3);font-family:'Geist Mono',monospace;}\n.empty a{font-size:11px;color:var(--fg);text-decoration:none;border-bottom:1px solid var(--line-strong);padding-bottom:1px;}\n/* partial */\n.partial{display:flex;align-items:center;gap:6px;font-size:10px;color:var(--warn);font-family:'Geist Mono',monospace;}\n.staleTag{position:absolute;right:6px;top:2px;font-family:'Geist Mono',monospace;font-size:9px;color:var(--warn);background:var(--panel);border:1px solid var(--line);border-radius:2px;padding:1px 4px;}\n</style>\n<div class=\"wrap\" data-kid=\"1\" data-name=\"graphics dashboard page layout\">\n<div class=\"h\" data-kid=\"1-1\" data-name=\"page header bar\">\n<h1 data-kid=\"1-1-1\" data-name=\"dashboard title heading\">Estados de gráfica</h1>\n<span data-kid=\"1-1-2\" data-name=\"header descriptive subtitle\">Contrato común para las cinco gráficas del producto</span>\n</div>\n<section class=\"panel\" data-kid=\"1-2\" data-name=\"probability-of-failure chart panel\">\n<div class=\"ptop\" data-kid=\"1-2-1\" data-name=\"chart panel header row\">\n<div class=\"t\" data-kid=\"1-2-1-1\" data-name=\"panel title group\"><b data-kid=\"1-2-1-1-1\" data-name='panel title label \"Probabilidad de falla\"'>Probabilidad de falla</b><span class=\"faint\" data-kid=\"1-2-1-1-2\" data-name=\"loading status tag\" style=\"margin-left:6px\">cargando</span></div>\n<span class=\"lblsk\" data-kid=\"1-2-1-2\" data-name=\"loading skeleton text spacer\" style=\"width:74px\"></span>\n</div>\n<div class=\"chart\" data-kid=\"1-2-2\" data-name=\"chart plot area\">\n<div class=\"gut\" data-kid=\"1-2-2-1\" data-name=\"vertical axis gutter\"><span data-kid=\"1-2-2-1-1\" data-name=\"Y-axis label 100\" style=\"top:8px\">100</span><span data-kid=\"1-2-2-1-2\" data-name=\"Y-axis label 50\" style=\"top:70px\">50</span><span data-kid=\"1-2-2-1-3\" data-name=\"Y-axis label 0\" style=\"top:132px\">0</span></div>\n<div class=\"plot\" data-kid=\"1-2-2-2\" data-name=\"plot drawing region\">\n<svg data-kid=\"1-2-2-2-1\" data-name=\"chart gridlines SVG\" preserveaspectratio=\"none\" viewbox=\"0 0 1010 140\">\n<line stroke=\"var(--grid)\" x1=\"0\" x2=\"1010\" y1=\"8\" y2=\"8\"></line>\n<line stroke=\"var(--grid)\" x1=\"0\" x2=\"1010\" y1=\"70\" y2=\"70\"></line>\n<line stroke=\"var(--grid)\" x1=\"0\" x2=\"1010\" y1=\"132\" y2=\"132\"></line>\n</svg>\n<div class=\"sk\" data-kid=\"1-2-2-2-2\" data-name=\"loading skeleton bar 1\" style=\"left:0;top:78px;width:180px;height:10px\"></div>\n<div class=\"sk\" data-kid=\"1-2-2-2-3\" data-name=\"loading skeleton bar 2\" style=\"left:200px;top:64px;width:180px;height:10px\"></div>\n<div class=\"sk\" data-kid=\"1-2-2-2-4\" data-name=\"loading skeleton bar 3\" style=\"left:400px;top:70px;width:180px;height:10px\"></div>\n<div class=\"sk\" data-kid=\"1-2-2-2-5\" data-name=\"loading skeleton bar 4\" style=\"left:600px;top:52px;width:180px;height:10px\"></div>\n<div class=\"sk\" data-kid=\"1-2-2-2-6\" data-name=\"loading skeleton bar 5\" style=\"left:800px;top:34px;width:200px;height:10px\"></div>\n</div>\n</div>\n</section>\n<section class=\"panel\" data-kid=\"1-3\" data-name=\"probability-of-failure chart panel\">\n<div class=\"ptop\" data-kid=\"1-3-1\" data-name=\"chart panel header row\">\n<div class=\"t\" data-kid=\"1-3-1-1\" data-name=\"panel title group\"><b data-kid=\"1-3-1-1-1\" data-name='panel title label \"Probabilidad de falla\"'>Probabilidad de falla</b><span class=\"faint\" data-kid=\"1-3-1-1-2\" data-name=\"no-data status tag\" style=\"margin-left:6px\">sin datos</span></div>\n<div class=\"seg\" data-kid=\"1-3-1-2\" data-name=\"time range segmented control\" style=\"display:flex;border:1px solid var(--line);border-radius:3px;overflow:hidden\"><span data-kid=\"1-3-1-2-1\" data-name=\"time range option 1 h\" style=\"padding:2px 7px;font-size:10px;color:var(--fg-3);font-family:'Geist Mono',monospace\">1 h</span><span data-kid=\"1-3-1-2-2\" data-name=\"selected time range option 24 h\" style=\"padding:2px 7px;font-size:10px;color:var(--fg);font-family:'Geist Mono',monospace;background:var(--sel)\">24 h</span><span data-kid=\"1-3-1-2-3\" data-name=\"time range option 7 d\" style=\"padding:2px 7px;font-size:10px;color:var(--fg-3);font-family:'Geist Mono',monospace\">7 d</span></div>\n</div>\n<div class=\"chart\" data-kid=\"1-3-2\" data-name=\"chart plot area\">\n<div class=\"gut\" data-kid=\"1-3-2-1\" data-name=\"vertical axis gutter\"><span data-kid=\"1-3-2-1-1\" data-name=\"Y-axis label 100\" style=\"top:8px\">100</span><span data-kid=\"1-3-2-1-2\" data-name=\"Y-axis label 50\" style=\"top:70px\">50</span><span data-kid=\"1-3-2-1-3\" data-name=\"Y-axis label 0\" style=\"top:132px\">0</span></div>\n<div class=\"plot\" data-kid=\"1-3-2-2\" data-name=\"plot drawing region\">\n<svg data-kid=\"1-3-2-2-1\" data-name=\"chart gridlines and baseline SVG\" preserveaspectratio=\"none\" viewbox=\"0 0 1010 140\">\n<line stroke=\"var(--grid)\" x1=\"0\" x2=\"1010\" y1=\"8\" y2=\"8\"></line>\n<line stroke=\"var(--grid)\" x1=\"0\" x2=\"1010\" y1=\"70\" y2=\"70\"></line>\n<line stroke=\"var(--line-strong)\" x1=\"0\" x2=\"1010\" y1=\"132\" y2=\"132\"></line>\n<line opacity=\".5\" stroke=\"var(--fg-3)\" stroke-dasharray=\"4 4\" stroke-width=\"1\" x1=\"0\" x2=\"1010\" y1=\"70\" y2=\"70\"></line>\n</svg>\n<div class=\"empty\" data-kid=\"1-3-2-2-2\" data-name=\"empty state overlay\">\n<div data-kid=\"1-3-2-2-2-1\" data-name=\"empty state content card\" style=\"background:var(--panel);padding:10px 18px;border-radius:4px;display:flex;flex-direction:column;align-items:center;gap:6px\">\n<div class=\"e1\" data-kid=\"1-3-2-2-2-1-1\" data-name=\"empty state message text\">Sin lecturas en este rango</div>\n<div class=\"e2\" data-kid=\"1-3-2-2-2-1-2\" data-name=\"empty state time range text\">22 nov 13:00 — 23 nov 13:00</div>\n<a data-kid=\"1-3-2-2-2-1-3\" data-name=\"change range link\" href=\"#\">Cambiar rango</a>\n</div>\n</div>\n</div>\n</div>\n</section>\n<section class=\"panel\" data-kid=\"1-4\" data-name=\"probability-of-failure chart panel\">\n<div class=\"ptop\" data-kid=\"1-4-1\" data-name=\"chart panel header row\">\n<div class=\"t\" data-kid=\"1-4-1-1\" data-name=\"panel title group\"><b data-kid=\"1-4-1-1-1\" data-name='panel title label \"Probabilidad de falla\"'>Probabilidad de falla</b><span class=\"faint\" data-kid=\"1-4-1-1-2\" data-name=\"incomplete reading status tag\" style=\"margin-left:6px\">lectura incompleta</span></div>\n<div class=\"partial\" data-kid=\"1-4-1-2\" data-name=\"partial data warning indicator\"><i class=\"icon-triangle-alert\" data-kid=\"1-4-1-2-1\" data-name=\"warning triangle icon\" style=\"font-size:12px\"></i>sin lecturas desde 11:20</div>\n</div>\n<div class=\"chart\" data-kid=\"1-4-2\" data-name=\"chart plot area\">\n<div class=\"gut\" data-kid=\"1-4-2-1\" data-name=\"vertical axis gutter\"><span data-kid=\"1-4-2-1-1\" data-name=\"Y-axis label 100\" style=\"top:8px\">100</span><span data-kid=\"1-4-2-1-2\" data-name=\"Y-axis label 50\" style=\"top:70px\">50</span><span data-kid=\"1-4-2-1-3\" data-name=\"Y-axis label 0\" style=\"top:132px\">0</span></div>\n<div class=\"plot\" data-kid=\"1-4-2-2\" data-name=\"plot drawing region\">\n<span class=\"staleTag\" data-kid=\"1-4-2-2-1\" data-name=\"stale last-reading tag\">última lectura 11:20</span>\n<svg data-kid=\"1-4-2-2-2\" data-name=\"probability trend line SVG\" preserveaspectratio=\"none\" viewbox=\"0 0 1010 140\">\n<line stroke=\"var(--grid)\" x1=\"0\" x2=\"1010\" y1=\"8\" y2=\"8\"></line>\n<line stroke=\"var(--grid)\" x1=\"0\" x2=\"1010\" y1=\"70\" y2=\"70\"></line>\n<line stroke=\"var(--line-strong)\" x1=\"0\" x2=\"1010\" y1=\"132\" y2=\"132\"></line>\n<line opacity=\".5\" stroke=\"var(--fg-3)\" stroke-dasharray=\"4 4\" stroke-width=\"1\" x1=\"0\" x2=\"1010\" y1=\"70\" y2=\"70\"></line>\n<path d=\"M0 96 L60 94 L120 95 L180 90 L240 91 L300 84 L360 86 L420 78 L480 74 L540 70 L600 62 L660 65\" fill=\"none\" stroke=\"var(--risk)\" stroke-linejoin=\"round\" stroke-width=\"1.7\"></path>\n<circle cx=\"660\" cy=\"65\" fill=\"var(--warn)\" r=\"3\"></circle>\n<line opacity=\".45\" stroke=\"var(--warn)\" stroke-dasharray=\"2 4\" stroke-width=\"1\" x1=\"660\" x2=\"660\" y1=\"8\" y2=\"132\"></line>\n</svg>\n</div>\n</div>\n</section>\n</div>",
