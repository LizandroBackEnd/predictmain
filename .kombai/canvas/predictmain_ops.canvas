city=\".28\" stroke=\"var(--crit)\" stroke-dasharray=\"2 3\" stroke-width=\"1\" x1=\"978\" x2=\"978\" y1=\"4\" y2=\"68\"></line>\n<line opacity=\".55\" stroke=\"var(--warn)\" stroke-dasharray=\"4 4\" stroke-width=\"1\" x1=\"0\" x2=\"1010\" y1=\"21\" y2=\"21\"></line>\n<path d=\"M0 52 L11 52 L21 53 L32 51 L43 52 L53 51 L64 50 L74 52 L85 50 L96 51 L106 51 L117 51 L128 51 L138 51 L149 50 L159 51 L170 50 L181 50 L191 52 L202 51 L213 51 L223 50 L234 51 L245 50 L255 50 L266 49 L276 49 L287 49 L298 51 L308 49 L319 50 L330 49 L340 50 L351 49 L361 48 L372 49 L383 49 L393 49 L404 49 L415 50 L425 48 L436 49 L447 50 L457 49 L468 49 L478 50 L489 48 L500 50 L510 48 L521 49 L532 50 L542 49 L553 49 L563 50 L574 48 L585 48 L595 48 L606 48 L617 48 L627 47 L638 49 L649 48 L659 48 L670 47 L680 46 L691 46 L702 46 L712 45 L723 47 L734 46 L744 46 L755 44 L765 44 L776 44 L787 43 L797 43 L808 42 L819 41 L829 41 L840 38 L851 39 L861 37 L872 36 L882 35 L893 33 L904 33 L914 31 L925 31 L936 29 L946 28 L957 26 L967 25 L978 22 L989 23 L999 20 L1010 19\" fill=\"none\" stroke=\"var(--torque)\" stroke-width=\"1.5\"></path>\n</svg>\n</div>\n</div>\n<div class=\"track\" data-kid=\"1-2-2-3-5\" data-name=\"tool wear chart track\" style=\"margin-top:14px\">\n<div class=\"tlab\" data-kid=\"1-2-2-3-5-1\" data-name=\"tool wear legend block\">\n<div class=\"tname\" data-kid=\"1-2-2-3-5-1-1\" data-name=\"tool wear series name\">Desgaste [min]</div>\n<div class=\"srow\" data-kid=\"1-2-2-3-5-1-2\" data-name=\"accumulated wear legend entry\" style=\"--c:var(--wear)\"><span class=\"sw2\" data-kid=\"1-2-2-3-5-1-2-1\" data-name=\"wear legend line swatch\"></span><span data-kid=\"1-2-2-3-5-1-2-2\" data-name=\"accumulated wear legend label\">Acumulado</span><b data-kid=\"1-2-2-3-5-1-2-3\" data-name=\"accumulated wear legend value\">231</b></div>\n<div class=\"tlim\" data-kid=\"1-2-2-3-5-1-3\" data-name=\"wear limit text\" style=\"color:var(--crit)\">límite 240</div>\n</div>\n<div class=\"tyaxis\" data-kid=\"1-2-2-3-5-2\" data-name=\"wear y axis labels\"><span data-kid=\"1-2-2-3-5-2-1\" data-name=\"wear axis top tick label\" style=\"top:8px\">250</span><span data-kid=\"1-2-2-3-5-2-2\" data-name=\"wear axis middle tick label\" style=\"top:36px\">175</span><span data-kid=\"1-2-2-3-5-2-3\" data-name=\"wear axis bottom tick label\" style=\"top:64px\">100</span></div>\n<div class=\"tplot\" data-kid=\"1-2-2-3-5-3\" data-name=\"wear plot area\">\n<svg data-kid=\"1-2-2-3-5-3-1\" data-name=\"wear line chart\" height=\"72\" viewbox=\"0 0 1024 72\">\n<line stroke=\"var(--grid)\" x1=\"0\" x2=\"1010\" y1=\"8\" y2=\"8\"></line>\n<line stroke=\"var(--grid)\" x1=\"0\" x2=\"1010\" y1=\"36\" y2=\"36\"></line>\n<line stroke=\"var(--line-strong)\" x1=\"0\" x2=\"1010\" y1=\"64\" y2=\"64\"></line>\n<line opacity=\".28\" stroke=\"var(--crit)\" stroke-dasharray=\"2 3\" stroke-width=\"1\" x1=\"978\" x2=\"978\" y1=\"4\" y2=\"68\"></line>\n<line opacity=\".6\" stroke=\"var(--crit)\" stroke-dasharray=\"4 4\" stroke-width=\"1\" x1=\"0\" x2=\"1010\" y1=\"12\" y2=\"12\"></line>\n<path d=\"M0 61 L11 61 L21 60 L32 59 L43 59 L53 59 L64 58 L74 57 L85 57 L96 57 L106 56 L117 56 L128 55 L138 55 L149 54 L159 54 L170 53 L181 53 L191 52 L202 52 L213 51 L223 51 L234 50 L245 50 L255 49 L266 49 L276 48 L287 47 L298 47 L308 46 L319 46 L330 46 L340 45 L351 45 L361 44 L372 44 L383 44 L393 43 L404 42 L415 42 L425 42 L436 41 L447 41 L457 40 L468 40 L478 39 L489 39 L500 38 L510 38 L521 37 L532 37 L542 37 L553 36 L563 36 L574 35 L585 35 L595 34 L606 34 L617 33 L627 33 L638 32 L649 32 L659 31 L670 31 L680 30 L691 30 L702 29 L712 29 L723 28 L734 27 L744 27 L755 26 L765 26 L776 25 L787 25 L797 24 L808 24 L819 23 L829 23 L840 22 L851 22 L861 22 L872 21 L882 21 L893 20 L904 20 L914 19 L925 19 L936 18 L946 18 L957 17 L967 17 L978 17 L989 16 L999 16 L1010 15\" fill=\"none\" stroke=\"var(--wear)\" stroke-width=\"1.5\"></path>\n</svg>\n</div>\n</div>\n<div class=\"xaxis\" data-kid=\"1-2-2-3-6\" data-name=\"chart time axis labels\">\n<span data-kid=\"1-2-2-3-6-1\" data-name=\"time tick 13:00\">13:00</span><span data-kid=\"1-2-2-3-6-2\" data-name=\"time tick 17:00\">17:00</span><span data-kid=\"1-2-2-3-6-3\" data-name=\"time tick 21:00\">21:00</span><span data-kid=\"1-2-2-3-6-4\" data-name=\"time tick 01:00\">01:00</span><span data-kid=\"1-2-2-3-6-5\" data-name=\"time tick 05:00\">05:00</span><span data-kid=\"1-2-2-3-6-6\" data-name=\"time tick 09:00\">09:00</span><span data-kid=\"1-2-2-3-6-7\" data-name=\"time tick 13:00 end\">13:00</span>\n</div>\n</section>\n<section class=\"alerts\" data-kid=\"1-2-2-4\" data-name=\"recent alerts section\">\n<div class=\"aheadrow\" data-kid=\"1-2-2-4-1\" data-name=\"alerts heading row\">\n<h3 data-kid=\"1-2-2-4-1-1\" data-name=\"recent alerts heading\">Alertas recientes</h3>\n<a class=\"link\" data-kid=\"1-2-2-4-1-2\" data-name=\"view history link\" href=\"#\">Ver historial<i class=\"icon-arrow-right\" data-kid=\"1-2-2-4-1-2-1\" data-name=\"arrow right icon\"></i></a>\n</div>\n<div class=\"atable\" data-kid=\"1-2-2-4-2\" data-name=\"alerts table header row\"><span data-kid=\"1-2-2-4-2-1\" data-name=\"time column header\">Hora</span><span data-kid=\"1-2-2-4-2-2\" data-name=\"variable column header\">Variable</span><span data-kid=\"1-2-2-4-2-3\" data-name=\"measurement column header\">Medición</span><span data-kid=\"1-2-2-4-2-4\" data-name=\"limit column header\">Límite</span><span data-kid=\"1-2-2-4-2-5\" data-name=\"status column header\">Estado</span></div>\n<div class=\"atrow\" data-kid=\"1-2-2-4-3\" data-name=\"torque alert row\">\n<span class=\"t\" data-kid=\"1-2-2-4-3-1\" data-name=\"torque alert time\">12:47</span>\n<span class=\"var\" data-kid=\"1-2-2-4-3-2\" data-name=\"torque alert variable name\">Torque</span>\n<span class=\"meas\" data-kid=\"1-2-2-4-3-3\" data-name=\"torque alert measured value\">64.8 Nm</span>\n<span class=\"lim\" data-kid=\"1-2-2-4-3-4\" data-name=\"torque alert limit value\">61.0 Nm</span>\n<span class=\"state crit\" data-kid=\"1-2-2-4-3-5\" data-name=\"torque alert critical status\"><span class=\"dot crit\" data-kid=\"1-2-2-4-3-5-1\" data-name=\"critical status dot\"></span>Crítico</span>\n</div>\n<div class=\"atrow\" data-kid=\"1-2-2-4-4\" data-name=\"tool wear alert row\">\n<span class=\"t\" data-kid=\"1-2-2-4-4-1\" data-name=\"tool wear alert time\">11:58</span>\n<span class=\"var\" data-kid=\"1-2-2-4-4-2\" data-name=\"tool wear alert variable name\">Desgaste de herramienta</span>\n<span class=\"meas\" data-kid=\"1-2-2-4-4-3\" data-name=\"tool wear alert measured value\">228 min</span>\n<span class=\"lim\" data-kid=\"1-2-2-4-4-4\" data-name=\"tool wear alert limit value\">220 min</span>\n<span class=\"state crit\" data-kid=\"1-2-2-4-4-5\" data-name=\"tool wear alert critical status\"><span class=\"dot crit\" data-kid=\"1-2-2-4-4-5-1\" data-name=\"critical status dot\"></span>Crítico</span>\n</div>\n</section>\n</div>\n</div>\n</div>",
