    "var_ad439194beb0": {
      "type": "variant",
      "label": "Riesgo de falla — FR-204 (oscuro)",
      "parentId": "var_04affa0f8760",
      "themeId": null,
      "rect": {
        "x": 6160,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n:root{\n  --bg:#0B0C0D; --panel:#131416; --raised:#1B1D1F; --sel:#272B2E;\n  --line:#2B2F32; --line-strong:#3C4246;\n  --fg:#ECECEA; --fg-2:#A6ACB1; --fg-3:#767D82;\n  --btn-bg:#ECECEA; --btn-fg:#0B0C0D;\n  --crit:#F08D80; --crit-fill:rgba(240,141,128,.10);\n  --warn:#E3A954; --warn-fill:rgba(227,169,84,.10);\n  --ok:#79B58E;\n  --risk:#7FBAE0; --air:#7FBAE0; --proc:#E8AE69; --rpm:#77B6B5; --torque:#E5998A; --wear:#B6B6B6;\n  --grid:#242829; --band-fill:rgba(127,186,224,.055); --risk-fill:rgba(127,186,224,.20);\n}\n*{box-sizing:border-box;margin:0;padding:0;}\nbody{background:var(--bg);color:var(--fg);font-family:'Geist',system-ui,sans-serif;font-size:13px;-webkit-font-smoothing:antialiased;}\n.mono{font-family:'Geist Mono',monospace;font-feature-settings:\"tnum\" 1,\"zero\" 1;letter-spacing:-.01em;}\n.faint{color:var(--fg-3);} .muted{color:var(--fg-2);}\n.shell{display:flex;height:1156px;overflow:hidden;}\n.side{width:176px;flex:0 0 176px;border-right:1px solid var(--line);display:flex;flex-direction:column;}\n.brand{height:56px;display:flex;align-items:center;gap:9px;padding:0 16px;border-bottom:1px solid var(--line);}\n.mark{width:22px;height:22px;border-radius:3px;background:var(--fg);color:var(--bg);display:grid;place-items:center;font-family:'Geist Mono',monospace;font-size:10px;font-weight:600;}\n.brand b{font-size:13px;font-weight:600;letter-spacing:-.015em;}\n.brand span{display:block;font-size:9.5px;letter-spacing:.09em;text-transform:uppercase;color:var(--fg-3);margin-top:2px;}\n.nav{padding:12px 8px;display:flex;flex-direction:column;gap:2px;}\n.nav a{display:flex;align-items:center;gap:10px;height:34px;padding:0 9px;border-radius:4px;color:var(--fg-2);text-decoration:none;font-size:13px;}\n.nav a i{font-size:15px;color:var(--fg-3);}\n.nav a.on{background:var(--sel);color:var(--fg);font-weight:500;}\n.nav a.on i{color:var(--fg);}\n.nav-label{font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--fg-3);padding:14px 9px 6px;}\n.sidefoot{margin-top:auto;padding:14px 16px 16px;border-top:1px solid var(--line);font-size:10.5px;color:var(--fg-3);line-height:1.5;}\n.main{flex:1;display:flex;flex-direction:column;min-width:0;}\n.top{height:56px;flex:0 0 56px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 20px;}\n.scope{display:flex;align-items:center;gap:10px;}\n.plant{display:flex;align-items:center;gap:8px;height:30px;padding:0 9px;border:1px solid var(--line);border-radius:4px;color:var(--fg);background:var(--panel);font:inherit;font-size:12.5px;font-weight:500;}\n.plant i{font-size:13px;color:var(--fg-2);}\n.vr{width:1px;height:16px;background:var(--line);}\n.topright{display:flex;align-items:center;gap:14px;}\n.stamp{font-size:11px;color:var(--fg-3);}\n.btn{display:inline-flex;align-items:center;gap:7px;height:32px;padding:0 11px;border-radius:4px;border:1px solid var(--line-strong);background:transparent;color:var(--fg);font:inherit;font-size:12.5px;cursor:pointer;white-space:nowrap;}\n.btn i{font-size:14px;color:var(--fg-2);}\n.btn.solid{background:var(--btn-bg);color:var(--btn-fg);border-color:var(--btn-bg);font-weight:500;}\n.btn.solid i{color:var(--btn-fg);opacity:.75;}\n.ctl{display:flex;align-items:center;gap:7px;height:32px;padding:0 10px;border:1px solid var(--line);border-radius:4px;background:var(--panel);font-size:12px;color:var(--fg-2);white-space:nowrap;}\n.ctl b{color:var(--fg);font-weight:500;} .ctl i{font-size:12px;color:var(--fg-3);}\n.content{padding:20px;display:flex;flex-direction:column;gap:14px;flex:1;min-height:0;overflow:hidden;}\n.dot{width:6px;height:6px;border-radius:50%;display:inline-block;flex:0 0 6px;}\n.dot.crit{background:var(--crit);} .dot.warn{background:var(--warn);} .dot.ok{background:var(--ok);}\n.cond{display:flex;align-items:center;gap:6px;padding:4px 8px;border:1px solid var(--crit);border-radius:3px;color:var(--crit);font-size:11px;background:var(--crit-fill);white-space:nowrap;}\n.crumb{font-size:10.5px;color:var(--fg-3);}\n.vhead{display:flex;align-items:flex-end;justify-content:space-between;flex:0 0 auto;}\n.vhead h1{font-size:22px;font-weight:600;letter-spacing:-.022em;}\n.vhead h1 em{font-style:normal;color:var(--fg-3);font-weight:400;font-size:13px;letter-spacing:0;margin-left:10px;}\n/* estimate band */\n.est{border:1px solid var(--line);border-radius:6px;background:var(--panel);display:flex;align-items:stretch;flex:0 0 auto;}\n.estl{padding:14px 22px 14px 20px;border-right:1px solid var(--line);min-width:290px;}\n.estl .k{font-size:9.5px;letter-spacing:.07em;text-transform:uppercase;color:var(--fg-3);}\n.estl .big{font-family:'Geist Mono',monospace;font-size:46px;font-weight:500;letter-spacing:-.05em;line-height:1;margin-top:8px;}\n.estl .big em{font-style:normal;font-size:17px;color:var(--fg-2);margin-left:2px;}\n.estl .sub{font-size:10.5px;color:var(--fg-3);margin-top:9px;font-family:'Geist Mono',monospace;}\n.estl .sub b{color:var(--warn);font-weight:500;}\n.estf{flex:1;display:grid;grid-template-columns:repeat(4,1fr);padding:16px 22px;align-content:center;gap:18px 20px;}\n.estf .k{font-size:9.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--fg-3);}\n.estf .v{font-family:'Geist Mono',monospace;font-size:15px;margin-top:6px;}\n.estf .v u{text-decoration:none;font-size:9.5px;color:var(--fg-3);margin-left:3px;}\n.esthead{grid-column:1/-1;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);padding-bottom:7px;margin-bottom:-4px;}\n.esthead span{font-size:10px;letter-spacing:.05em;text-transform:uppercase;color:var(--fg-3);}\n.link{font-size:11px;color:var(--fg-2);text-decoration:none;display:flex;align-items:center;gap:4px;}\n.link i{font-size:12px;color:var(--fg-3);}\n/* chart */\n.panel{border:1px solid var(--line);border-radius:6px;background:var(--panel);padding:14px 20px 12px;display:flex;flex-direction:column;flex:0 0 400px;min-height:0;}\n.ptool{display:flex;align-items:center;justify-content:space-between;height:36px;flex:0 0 auto;}\n.ptool .lbl{font-size:11.5px;color:var(--fg-2);}\n.ptool .lbl b{color:var(--fg);font-weight:500;}\n.ptools{display:flex;align-items:center;gap:12px;}\n.seg{display:flex;border:1px solid var(--line);border-radius:3px;overflow:hidden;}\n.seg span{padding:3px 8px;font-size:11px;color:var(--fg-3);font-family:'Geist Mono',monospace;}\n.seg span.on{background:var(--sel);color:var(--fg);}\n.chart{display:flex;flex:1;min-height:0;margin-top:2px;}\n.tyaxis{width:38px;flex:0 0 38px;position:relative;}\n.tyaxis span{position:absolute;right:7px;transform:translateY(-50%);font-family:'Geist Mono',monospace;font-size:9px;color:var(--fg-3);}\n.plotwrap{flex:1;min-width:0;position:relative;}\n.plotwrap svg{display:block;width:100%;}\n.xaxis{display:flex;justify-content:space-between;margin-left:38px;padding-right:14px;font-family:'Geist Mono',monospace;font-size:9px;color:var(--fg-3);padding-top:2px;}\n.thrTag{position:absolute;left:10px;top:150px;font-family:'Geist Mono',monospace;font-size:9.5px;color:var(--fg-2);background:var(--panel);padding:1px 5px;border:1px solid var(--line);border-radius:2px;}\n/* action strip */\n.action{border:1px solid var(--line-strong);border-radius:6px;background:var(--raised);display:flex;align-items:center;gap:16px;padding:0 18px;height:64px;flex:0 0 auto;}\n.action .ic{width:30px;height:30px;border-radius:3px;border:1px solid var(--warn);color:var(--warn);display:grid;place-items:center;flex:0 0 30px;}\n.action .ic i{font-size:15px;}\n.action .txt{flex:1;min-width:0;}\n.action .t1{font-size:13px;font-weight:500;}\n.action .t2{font-size:11px;color:var(--fg-3);margin-top:3px;}\n.action .t2 b{color:var(--fg-2);font-weight:500;}\n/* evidence */\n.evid{flex:0 0 auto;}\n.evid .sh{display:flex;align-items:center;justify-content:space-between;height:30px;}\n.evid h3{font-size:12px;font-weight:600;letter-spacing:-.01em;}\n.evfields{display:grid;grid-template-columns:repeat(8,1fr);border-top:1px solid var(--line);padding-top:10px;}\n.evf .k{font-size:9.5px;letter-spacing:.05em;text-transform:uppercase;color:var(--fg-3);}\n.evf .v{font-family:'Geist Mono',monospace;font-size:14px;margin-top:5px;}\n.evf .v u{text-decoration:none;font-size:9px;color:var(--fg-3);margin-left:2px;}\n/* evaluation section */\n.eval{margin-top:8px;display:grid;grid-template-columns:1fr 1fr;gap:16px;flex:0 0 auto;}\n.epanel{border:1px solid var(--line);border-radius:6px;background:var(--panel);padding:16px 20px 18px;}\n.epanel h3{font-size:13px;font-weight:600;letter-spacing:-.01em;}\n.epanel .sub{font-size:10.5px;color:var(--fg-3);margin-top:4px;}\n.mtable{width:100%;border-collapse:collapse;margin-top:12px;}\n.mtable th{text-align:right;font-size:9.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--fg-3);font-weight:400;padding-bottom:8px;border-bottom:1px solid var(--line-strong);}\n.mtable th:first-child{text-align:left;}\n.mtable td{text-align:right;font-family:'Geist Mono',monospace;font-size:12.5px;padding:9px 0;border-bottom:1px solid var(--line);color:var(--fg-2);}\n.mtable td:first-child{text-align:left;color:var(--fg-2);}\n.mtable tr.sel td{color:var(--fg);font-weight:500;background:var(--sel);}\n.mtable tr.sel td:first-child{padding-left:8px;} .mtable tr.sel td:last-child{padding-right:8px;}\n.hbars{margin-top:14px;}\n.hb{display:grid;grid-template-columns:64px 1fr 40px;align-items:center;gap:10px;height:26px;}\n.hb .m{font-family:'Geist Mono',monospace;font-size:10.5px;color:var(--fg-2);}\n.hb .m u{text-decoration:none;color:var(--fg-3);font-size:9px;margin-left:4px;}\n.hb .track{height:8px;background:var(--line);position:relative;}\n.hb .fill{position:absolute;left:0;top:0;bottom:0;background:var(--fg-2);opacity:.75;}\n.hb .n{font-family:'Geist Mono',monospace;font-size:11px;text-align:right;color:var(--fg-2);}\n.scale{display:grid;grid-template-columns:64px 1fr 40px;gap:10px;margin-top:8px;}\n.scale .ruler{grid-column:2;display:flex;justify-content:space-between;font-family:'Geist Mono',monospace;font-size:9px;color:var(--fg-3);border-top:1px solid var(--line);padding-top:4px;}\n</style>\n<div class=\"shell\" data-kid=\"1\" data-name=\"page layout container with sidebar and main panel\">\n<aside class=\"side\" data-kid=\"1-1\" data-name=\"sidebar navigation panel\">\n<div class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand logo header\"><div class=\"mark\" data-kid=\"1-1-1-1\" data-name=\"brand monogram badge\">PM</div><div data-kid=\"1-1-1-2\" data-name=\"brand name label group\"><b data-kid=\"1-1-1-2-1\" data-name=\"brand product name text\">PredictMain</b><span data-kid=\"1-1-1-2-2\" data-name=\"brand tagline subtitle\">Mantenimiento</span></div></div>\n<nav class=\"nav\" data-kid=\"1-1-2\" data-name=\"sidbar navigation menu\">\n<div class=\"nav-label\" data-kid=\"1-1-2-1\" data-name=\"nav section label Operation\">Operación</div>\n<a data-kid=\"1-1-2-2\" data-name=\"nav link Operation with ordered-list icon\" href=\"#\"><i class=\"icon-list-ordered\" data-kid=\"1-1-2-2-1\" data-name=\"ordered-list icon\"></i>Operación</a>\n<a data-kid=\"1-1-2-3\" data-name=\"nav link Assets with factory icon\" href=\"#\"><i class=\"icon-factory\" data-kid=\"1-1-2-3-1\" data-name=\"factory icon\"></i>Activos</a>\n<a data-kid=\"1-1-2-4\" data-name=\"nav link Telemetry with chart icon\" href=\"#\"><i class=\"icon-chart-no-axes-combined\" data-kid=\"1-1-2-4-1\" data-name=\"combined chart icon\"></i>Telemetría</a>\n<a class=\"on\" data-kid=\"1-1-2-5\" data-name=\"nav link Failure risk (active) with alert icon\" href=\"#\"><i class=\"icon-triangle-alert\" data-kid=\"1-1-2-5-1\" data-name=\"triangle alert icon\"></i>Riesgo de falla</a>\n<a data-kid=\"1-1-2-6\" data-name=\"nav link Knowledge base with book icon\"