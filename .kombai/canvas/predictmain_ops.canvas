      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n:root{\n  --bg:#F4F4F1; --panel:#FFFFFF; --raised:#FAFAF6; --sel:#E9E9E2;\n  --line:#DCDCD4; --line-strong:#BFBFB4;\n  --fg:#141414; --fg-2:#53585B; --fg-3:#6E7377;\n  --btn-bg:#141414; --btn-fg:#FFFFFF;\n  --crit:#A32A22; --crit-fill:rgba(163,42,34,.07);\n  --warn:#7A4E00; --warn-fill:rgba(122,78,0,.07);\n  --ok:#2C5F40;\n  --risk:#185C7D; --air:#185C7D; --proc:#8A5200; --rpm:#175B5B; --torque:#8B3F2C; --wear:#5A5A5A;\n  --grid:#E8E8E0; --band-fill:rgba(24,92,125,.055); --risk-fill:rgba(24,92,125,.16);\n}\n*{box-sizing:border-box;margin:0;padding:0;}\nbody{background:var(--bg);color:var(--fg);font-family:'Geist',system-ui,sans-serif;font-size:13px;-webkit-font-smoothing:antialiased;}\n.mono{font-family:'Geist Mono',monospace;font-feature-settings:\"tnum\" 1,\"zero\" 1;letter-spacing:-.01em;}\n.faint{color:var(--fg-3);} .muted{color:var(--fg-2);}\n.shell{display:flex;height:900px;overflow:hidden;}\n.side{width:176px;flex:0 0 176px;border-right:1px solid var(--line);display:flex;flex-direction:column;}\n.brand{height:56px;display:flex;align-items:center;gap:9px;padding:0 16px;border-bottom:1px solid var(--line);}\n.mark{width:22px;height:22px;border-radius:3px;background:var(--fg);color:var(--bg);display:grid;place-items:center;font-family:'Geist Mono',monospace;font-size:10px;font-weight:600;letter-spacing:-.04em;}\n.brand b{font-size:13px;font-weight:600;letter-spacing:-.015em;}\n.brand span{display:block;font-size:9.5px;letter-spacing:.09em;text-transform:uppercase;color:var(--fg-3);margin-top:2px;}\n.nav{padding:12px 8px;display:flex;flex-direction:column;gap:2px;}\n.nav a{display:flex;align-items:center;gap:10px;height:34px;padding:0 9px;border-radius:4px;color:var(--fg-2);text-decoration:none;font-size:13px;}\n.nav a i{font-size:15px;color:var(--fg-3);}\n.nav a.on{background:var(--sel);color:var(--fg);font-weight:500;}\n.nav a.on i{color:var(--fg);}\n.nav-label{font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--fg-3);padding:14px 9px 6px;}\n.sidefoot{margin-top:auto;padding:14px 16px 16px;border-top:1px solid var(--line);font-size:10.5px;color:var(--fg-3);line-height:1.5;}\n.main{flex:1;display:flex;flex-direction:column;min-width:0;}\n.top{height:56px;flex:0 0 56px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 20px;}\n.scope{display:flex;align-items:center;gap:10px;}\n.plant{display:flex;align-items:center;gap:8px;height:30px;padding:0 9px;border:1px solid var(--line);border-radius:4px;color:var(--fg);background:var(--panel);font:inherit;font-size:12.5px;font-weight:500;}\n.plant i{font-size:13px;color:var(--fg-2);}\n.vr{width:1px;height:16px;background:var(--line);}\n.topright{display:flex;align-items:center;gap:14px;}\n.stamp{font-size:11px;color:var(--fg-3);}\n.btn{display:inline-flex;align-items:center;gap:7px;height:32px;padding:0 11px;border-radius:4px;border:1px solid var(--line-strong);background:transparent;color:var(--fg);font:inherit;font-size:12.5px;cursor:pointer;}\n.btn i{font-size:14px;color:var(--fg-2);}\n.btn.solid{background:var(--btn-bg);color:var(--btn-fg);border-color:var(--btn-bg);font-weight:500;}\n.btn.solid i{color:var(--btn-fg);opacity:.75;}\n.content{padding:20px;display:flex;flex-direction:column;gap:14px;flex:1;min-height:0;overflow:hidden;}\n.vhead{display:flex;align-items:flex-end;justify-content:space-between;flex:0 0 auto;}\n.vhead h1{font-size:22px;font-weight:600;letter-spacing:-.022em;}\n.vhead h1 em{font-style:normal;color:var(--fg-3);font-weight:400;font-size:13px;letter-spacing:0;margin-left:10px;}\n.controls{display:flex;align-items:center;gap:8px;}\n.sel-ctl{display:flex;align-items:center;gap:7px;height:30px;padding:0 9px;border:1px solid var(--line);border-radius:4px;font-size:12px;color:var(--fg-2);background:var(--panel);}\n.sel-ctl b{color:var(--fg);font-weight:500;} .sel-ctl i{font-size:12px;color:var(--fg-3);}\n.fleet{display:flex;align-items:center;height:38px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);flex:0 0 auto;}\n.fcell{display:flex;align-items:baseline;gap:7px;padding:0 18px;}\n.fcell:first-child{padding-left:0;}\n.fcell .n{font-family:'Geist Mono',monospace;font-size:15px;font-weight:500;}\n.fcell .l{font-size:11.5px;color:var(--fg-2);}\n.fdiv{width:1px;height:18px;background:var(--line);}\n.dot{width:6px;height:6px;border-radius:50%;display:inline-block;flex:0 0 6px;}\n.dot.crit{background:var(--crit);} .dot.warn{background:var(--warn);} .dot.ok{background:var(--ok);} .dot.none{background:var(--fg-3);}\n.ws{display:grid;grid-template-columns:640px 1fr;grid-template-rows:minmax(0,1fr);gap:16px;flex:1;min-height:0;}\n.queue{display:flex;flex-direction:column;min-height:0;}\n.qbar{display:flex;align-items:center;justify-content:space-between;height:44px;flex:0 0 auto;}\n.qbar .t{font-size:12px;color:var(--fg-2);}\n.sort{display:flex;align-items:center;gap:6px;height:26px;padding:0 8px;border:1px solid var(--line);border-radius:3px;font:inherit;font-size:11.5px;color:var(--fg);background:transparent;}\n.sort i{font-size:12px;color:var(--fg-3);}\n.qcount{font-size:11.5px;color:var(--fg-3);}\n.thead,.qrow{display:grid;grid-template-columns:212px 92px 116px 74px 1fr;align-items:center;padding:0 12px;}\n.thead{height:34px;flex:0 0 auto;border-bottom:1px solid var(--line-strong);font-size:9.5px;letter-spacing:.09em;text-transform:uppercase;color:var(--fg-3);}\n.thead span:nth-child(4),.thead span:nth-child(5){text-align:right;}\n.qrow{height:44px;flex:0 0 auto;border-bottom:1px solid var(--line);cursor:pointer;}\n.qrow .code{font-size:11.5px;color:var(--fg-2);}\n.qrow .nm{font-size:12.5px;color:var(--fg);margin-left:8px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}\n.c-asset{display:flex;align-items:baseline;min-width:0;padding-right:10px;}\n.c-line{display:flex;align-items:center;gap:6px;font-size:11.5px;color:var(--fg-2);}\n.lc{font-family:'Geist Mono',monospace;font-size:10px;padding:1px 4px;border:1px solid var(--line);border-radius:2px;color:var(--fg-2);}\n.c-cond{display:flex;align-items:center;gap:7px;font-size:11.5px;color:var(--fg-2);}\n.c-cond.crit{color:var(--crit);} .c-cond.warn{color:var(--warn);}\n.c-risk{text-align:right;font-size:13px;color:var(--fg);}\n.c-risk.crit{color:var(--crit);} .c-risk.warn{color:var(--warn);} .c-risk.none{color:var(--fg-3);}\n.c-risk s{text-decoration:none;font-size:9px;color:var(--fg-3);margin-left:1px;}\n.c-read{text-align:right;font-size:11.5px;color:var(--fg-3);}\n.qrow.sel{background:var(--sel);}\n.qrow.sel .nm{font-weight:600;} .qrow.sel .code{color:var(--fg);}\n.qfoot{height:44px;margin-top:auto;display:flex;align-items:center;justify-content:space-between;font-size:11px;color:var(--fg-3);border-top:1px solid var(--line);}\n.pager{display:flex;gap:4px;}\n.pg{width:22px;height:22px;display:grid;place-items:center;border:1px solid var(--line);border-radius:3px;color:var(--fg-3);font-size:11px;}\n.pg.on{border-color:var(--line-strong);color:var(--fg);}\n.ev{border:1px solid var(--line);border-radius:6px;background:var(--panel);display:flex;flex-direction:column;padding:18px 20px 16px;min-height:0;}\n.evhead{display:flex;align-items:flex-start;justify-content:space-between;padding-bottom:14px;flex:0 0 auto;}\n.evhead .code{font-size:11px;color:var(--fg-3);letter-spacing:.04em;}\n.evhead h2{font-size:15px;font-weight:600;letter-spacing:-.012em;margin-top:3px;}\n.evmeta{display:flex;gap:14px;margin-top:5px;font-size:11px;color:var(--fg-3);}\n.cond{display:flex;align-items:center;gap:6px;padding:4px 8px;border:1px solid var(--crit);border-radius:3px;color:var(--crit);font-size:11px;background:var(--crit-fill);}\n.evtitle{display:flex;align-items:center;justify-content:space-between;margin-top:2